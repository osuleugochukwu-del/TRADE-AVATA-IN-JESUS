<script>
  import {
    getAuth,
    onAuthStateChanged
  } from 'firebase/auth';

  import {
    doc,
    getDoc,
    getFirestore
  } from 'firebase/firestore';

  import {
    firebaseApp
  } from '../lib/firebase/config.js';

  const base =
    document.body?.dataset?.baseUrl || '/';

  async function check() {
    if (!firebaseApp) {
      return;
    }

    try {
      const db =
        getFirestore(firebaseApp);

      const auth =
        getAuth(firebaseApp);

      const snapshot =
        await getDoc(
          doc(
            db,
            'siteSettings',
            'global'
          )
        );

      if (
        !snapshot.exists() ||
        !snapshot.data().maintenanceMode
      ) {
        return;
      }

      const settings =
        snapshot.data();

      const allowAdmin =
        settings.allowAdminAccess !== false;

      const allowTester =
        settings.allowTesterAccess !== false;

      onAuthStateChanged(
        auth,
        async user => {
          let allowed = false;

          if (user) {
            const roleSnapshot =
              await getDoc(
                doc(
                  db,
                  'roles',
                  user.uid
                )
              );

            const roleData =
              roleSnapshot.exists()
                ? roleSnapshot.data()
                : {};

            allowed =
              (
                allowAdmin &&
                [
                  'superAdmin',
                  'admin',
                  'staff'
                ].includes(
                  roleData.role
                )
              ) ||
              (
                allowTester &&
                (
                  roleData.role ===
                    'copyTradingTester' ||
                  roleData.permissions
                    ?.includes?.(
                      'maintenance.bypass'
                    )
                )
              );
          }

          if (!allowed) {
            location.href =
              base + 'maintenance/';
          }
        }
      );
    } catch (error) {
      console.error(
        'Maintenance check error:',
        error
      );
    }
  }

  check();
</script>
