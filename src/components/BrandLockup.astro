---
const { href = import.meta.env.BASE_URL, theme = 'dark', compact = false, class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class:list={['ta-brand-lockup', `theme-${theme}`, compact && 'compact', className]} href={href} aria-label="Trade Avata home">
  <img src={`${base}brand/trade-avata-mark.png`} alt="" />
  <span class="ta-brand-copy"><strong>Trade Avata</strong><small>Trade Simple.</small></span>
</a>
<style>
.ta-brand-lockup{display:inline-flex;align-items:center;gap:9px;text-decoration:none;min-width:max-content;line-height:1}.ta-brand-lockup img{width:36px;height:36px;object-fit:contain;flex:0 0 auto}.ta-brand-copy{display:grid;gap:4px}.ta-brand-copy strong{font:800 15px/1.02 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;letter-spacing:-.02em}.ta-brand-copy small{font:700 10px/1.05 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;letter-spacing:.045em}.theme-dark .ta-brand-copy strong{color:#fff}.theme-dark .ta-brand-copy small{color:#a9c5df}.theme-light .ta-brand-copy strong{color:#10243a}.theme-light .ta-brand-copy small{color:#4f7698}.compact img{width:31px;height:31px}.compact .ta-brand-copy strong{font-size:13px}.compact .ta-brand-copy small{font-size:9px}@media(max-width:640px){.ta-brand-lockup{gap:7px}.ta-brand-lockup img{width:32px;height:32px}.ta-brand-copy strong{font-size:13px}.ta-brand-copy small{font-size:9px}}
</style>
