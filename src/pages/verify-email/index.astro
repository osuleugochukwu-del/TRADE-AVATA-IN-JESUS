---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Verify your email — Trade Avata">
  <section class="auth-shell">
    <div class="auth-card" style="text-align:center">
      <span class="eyebrow">Account confirmation</span>

      <h1>Check your email</h1>

      <p>
        We use email verification to confirm account ownership.
        Open the verification message, then return to sign in.
      </p>

      <p
        data-email-hint
        style="color:var(--muted);margin-top:.6rem"
      ></p>

      <div
        style="
          display:flex;
          gap:.75rem;
          justify-content:center;
          flex-wrap:wrap;
          margin-top:1rem;
        "
      >
        <button
          class="button"
          type="button"
          data-resend
        >
          Resend verification email
        </button>

        <a
          class="button"
          href={`${base}login/`}
        >
          Back to login
        </a>
      </div>

      <small
        data-status
        style="
          display:block;
          color:var(--muted);
          margin-top:1rem;
        "
      ></small>
    </div>
  </section>

  <script>
    import {
      onAuthStateChanged,
      sendEmailVerification
    } from 'firebase/auth';

    import { auth } from '../../lib/firebase/auth.js';

    const status = document.querySelector('[data-status]');
    const emailHint = document.querySelector('[data-email-hint]');
    const resendButton = document.querySelector('[data-resend]');

    const params = new URLSearchParams(location.search);

    if (params.get('sent') === '1') {
      status.textContent =
        'Verification email requested. Check Inbox, Spam/Junk and Promotions.';
    }

    if (params.get('sendFailed') === '1') {
      status.textContent =
        'Your account was created, but the verification email could not be confirmed as sent. Use the resend button below.';
    }

    if (!auth) {
      status.textContent =
        'Firebase Authentication is not available on this build.';

      resendButton.disabled = true;
    } else {
      onAuthStateChanged(auth, (user) => {
        if (!user) {
          emailHint.textContent =
            'Your sign-in session is not active. Please sign in again if you need to resend the verification email.';

          resendButton.disabled = true;
          return;
        }

        if (user.email) {
          emailHint.textContent =
            `Verification will be sent to ${user.email}`;
        }

        if (user.emailVerified) {
          status.textContent =
            'Your email is already verified. You can return to login.';

          resendButton.disabled = true;
        }
      });

      resendButton?.addEventListener('click', async () => {
        const user = auth.currentUser;

        if (!user) {
          status.textContent =
            'Please sign in again before resending the verification email.';
          return;
        }

        resendButton.disabled = true;
        status.textContent = 'Sending verification email…';

        try {
          await sendEmailVerification(user);

          status.textContent =
            'Verification email sent. Check Inbox, Spam/Junk and Promotions.';

        } catch (error) {
          console.error('Resend verification error:', error);

          if (error?.code === 'auth/too-many-requests') {
            status.textContent =
              'Too many verification requests were made. Wait a little while, then try again.';
          } else {
            status.textContent =
              error?.message ||
              'The verification email could not be sent.';
          }
        } finally {
          if (!user.emailVerified) {
            resendButton.disabled = false;
          }
        }
      });
    }
  </script>
</BaseLayout>
