---
import BaseLayout from '../../layouts/BaseLayout.astro'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Verify your email — Trade Avata"><section class="auth-shell"><div class="auth-card" style="text-align:center"><span class="eyebrow">Account confirmation</span><h1>Check your email</h1><p>We use email verification to confirm account ownership. Open the verification message, then return to sign in.</p><a class="button" href={`${base}login/`}>Back to login</a></div></section></BaseLayout>
