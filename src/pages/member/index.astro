<script>
  import {
    onAuthStateChanged,
    signOut
  } from 'firebase/auth';

  import {
    auth
  } from '../../lib/firebase/auth.js';


  const base =
    document.body.dataset.baseUrl || '/';


  const account =
    document.querySelector(
      '[data-member-account]'
    );


  const accountButton =
    document.querySelector(
      '[data-member-account-button]'
    );


  const accountDropdown =
    document.querySelector(
      '[data-member-account-dropdown]'
    );


  const logoutButton =
    document.querySelector(
      '[data-member-logout]'
    );


  /*
    DashboardLayout still creates an old
    simple static profile badge.

    Hide it because the Member Area now
    has the real account dropdown.
  */

  const oldDashboardProfile =
    document.querySelector(
      '.dash-profile'
    );


  if (oldDashboardProfile) {

    oldDashboardProfile.style.display =
      'none';

  }


  function getMemberName(user) {

    const displayName =
      String(
        user?.displayName || ''
      ).trim();


    if (displayName) {
      return displayName;
    }


    const email =
      String(
        user?.email || ''
      ).trim();


    if (email.includes('@')) {

      const emailName =
        email
          .split('@')[0]
          .trim();


      if (emailName) {

        return emailName
          .charAt(0)
          .toUpperCase() +
          emailName.slice(1);

      }

    }


    return 'Member';
  }


  function getMemberInitial(name) {

    const cleanName =
      String(name || '')
        .trim();


    if (!cleanName) {
      return 'M';
    }


    return cleanName
      .charAt(0)
      .toUpperCase();
  }


  function showMemberIdentity(user) {

    const name =
      getMemberName(user);


    const email =
      String(
        user?.email || ''
      ).trim();


    const initial =
      getMemberInitial(name);


    document
      .querySelectorAll(
        '[data-member-name]'
      )
      .forEach(
        element => {

          element.textContent =
            name;

        }
      );


    document
      .querySelectorAll(
        '[data-member-email]'
      )
      .forEach(
        element => {

          element.textContent =
            email ||
            'Trade Avata member';

        }
      );


    document
      .querySelectorAll(
        '[data-member-initial]'
      )
      .forEach(
        element => {

          element.textContent =
            initial;

        }
      );

  }


  /*
    OPEN / CLOSE ACCOUNT MENU
  */

  accountButton
    ?.addEventListener(
      'click',
      event => {

        event.preventDefault();
        event.stopPropagation();


        const willOpen =
          accountDropdown.hidden;


        accountDropdown.hidden =
          !willOpen;


        accountButton.setAttribute(
          'aria-expanded',
          String(willOpen)
        );

      }
    );


  document.addEventListener(
    'click',
    event => {

      if (
        !accountDropdown ||
        accountDropdown.hidden
      ) {
        return;
      }


      if (
        account?.contains(
          event.target
        )
      ) {
        return;
      }


      accountDropdown.hidden =
        true;


      accountButton
        ?.setAttribute(
          'aria-expanded',
          'false'
        );

    }
  );


  document.addEventListener(
    'keydown',
    event => {

      if (
        event.key !== 'Escape' ||
        !accountDropdown
      ) {
        return;
      }


      accountDropdown.hidden =
        true;


      accountButton
        ?.setAttribute(
          'aria-expanded',
          'false'
        );

    }
  );


  /*
    LOG OUT
  */

  logoutButton
    ?.addEventListener(
      'click',
      async () => {

        if (!auth) {
          return;
        }


        logoutButton.disabled =
          true;


        logoutButton.textContent =
          'Logging out…';


        try {

          await signOut(auth);


          location.replace(
            base
          );


        } catch (error) {

          console.error(
            'Logout failed:',
            error
          );


          logoutButton.disabled =
            false;


          logoutButton.textContent =
            'Log out';

        }

      }
    );


  /*
    MEMBER AUTHENTICATION

    The protected dashboard remains hidden
    until this check succeeds.
  */

  if (!auth) {

    location.replace(
      `${base}login/`
    );

  } else {

    onAuthStateChanged(
      auth,
      async user => {

        if (!user) {

          location.replace(
            `${base}login/`
          );

          return;

        }


        try {

          await user.reload();


          if (!user.emailVerified) {

            location.replace(
              `${base}verify-email/?required=1`
            );

            return;

          }


          showMemberIdentity(
            user
          );


          /*
            Firebase has now confirmed:
            signed in + email verified.

            Only now reveal the dashboard.
          */

          document.documentElement
            .classList.add(
              'member-auth-ready'
            );


        } catch (error) {

          console.error(
            'Member authentication check failed:',
            error
          );


          location.replace(
            `${base}login/`
          );

        }

      }
    );

  }
</script>
