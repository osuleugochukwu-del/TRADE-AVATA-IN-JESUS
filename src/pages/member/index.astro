---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const base = import.meta.env.BASE_URL;

const nav = [
  { label:'Dashboard', icon:'⌂', href:'#home', active:true },
  { label:'My Courses', icon:'▤', href:`${base}courses/` },
  { label:'My Library', icon:'▥', href:'#library' },
  { label:'My Purchases', icon:'◇', href:'#purchases' },
  { label:'Saved Content', icon:'★', href:'#saved' },
  { label:'Downloads', icon:'⇩', href:'#downloads' },
  { label:'Certificates', icon:'✓', href:'#certificates' },
  { label:'Notifications', icon:'◉', href:'#notifications' },
  { label:'Support', icon:'?', href:`${base}contact/` },
  { label:'Profile', icon:'○', href:'#profile' },
  { label:'Settings', icon:'⚙', href:'#settings' }
];
---

<style is:global>
  /*
    Keep the entire protected dashboard hidden
    until Firebase confirms the user is signed in.
  */

  .dash-shell {
    visibility: hidden;
    opacity: 0;
  }

  html.member-auth-ready .dash-shell {
    visibility: visible;
    opacity: 1;
    transition: opacity .12s ease;
  }

  html:not(.member-auth-ready) body::after {
    content: 'Checking your Trade Avata account…';

    position: fixed;
    inset: 0;
    z-index: 99999;

    display: grid;
    place-items: center;

    background: #06101d;
    color: #a9c5df;

    font-size: 12px;
    font-weight: 700;
  }

  html.member-auth-ready body::after {
    display: none;
  }
</style>


<style>
  .member-top-welcome {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .member-top-welcome strong {
    color: var(--d-text);
    font-size: 13px;
    line-height: 1.15;
    white-space: nowrap;
  }

  .member-top-welcome small {
    color: var(--d-muted);
    font-size: 9px;
    max-width: 260px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .member-account {
    position: relative;
  }

  .member-account-button {
    min-height: 34px;

    display: flex;
    align-items: center;
    gap: 7px;

    padding: 4px 9px 4px 5px;

    border: 1px solid var(--d-line);
    border-radius: 8px;

    background: var(--d-panel);
    color: var(--d-text);

    cursor: pointer;

    font-size: 10px;
    font-weight: 750;
  }

  .member-account-button:hover {
    background: var(--d-panel2);
  }

  .member-account-avatar {
    width: 25px;
    height: 25px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    border-radius: 50%;

    background:
      linear-gradient(
        135deg,
        #0784f8,
        #32c8ff
      );

    color: #fff;

    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .member-account-arrow {
    font-size: 8px;
    color: var(--d-muted);
  }

  .member-account-dropdown {
    position: absolute;

    top: calc(100% + 8px);
    right: 0;

    width: 235px;

    padding: 9px;

    background: var(--d-panel);
    border: 1px solid var(--d-line);
    border-radius: 11px;

    box-shadow:
      0 22px 55px
      rgba(0, 0, 0, .34);

    z-index: 100;
  }

  .member-account-dropdown[hidden] {
    display: none !important;
  }

  .member-account-head {
    display: flex;
    align-items: center;
    gap: 9px;

    padding: 7px;

    border-bottom: 1px solid var(--d-line);
    margin-bottom: 5px;
  }

  .member-account-head div {
    min-width: 0;
  }

  .member-account-head strong {
    display: block;

    color: var(--d-text);
    font-size: 11px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .member-account-head small {
    display: block;

    margin-top: 2px;

    color: var(--d-muted);
    font-size: 8px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .member-account-links {
    display: grid;
  }

  .member-account-links a {
    padding: 8px 9px;

    border-radius: 7px;

    color: var(--d-muted);
    font-size: 10px;
  }

  .member-account-links a:hover {
    background: var(--d-panel2);
    color: var(--d-text);
  }

  .member-logout {
    width: 100%;

    margin-top: 6px;
    padding: 8px 9px;

    border: 1px solid
      color-mix(
        in srgb,
        var(--d-bad) 40%,
        var(--d-line)
      );

    border-radius: 7px;

    background:
      color-mix(
        in srgb,
        var(--d-bad) 8%,
        var(--d-panel)
      );

    color: var(--d-bad);

    text-align: left;

    font-size: 10px;
    font-weight: 750;

    cursor: pointer;
  }

  .member-logout:hover {
    background:
      color-mix(
        in srgb,
        var(--d-bad) 14%,
        var(--d-panel)
      );
  }

  .member-profile-summary {
    display: flex;
    align-items: center;
    gap: 12px;

    margin: 14px 0 16px;
    padding: 13px;

    background: var(--d-panel2);
    border: 1px solid rgba(120, 160, 195, .18);
    border-radius: 12px;
  }

  .member-avatar {
    width: 46px;
    height: 46px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    border-radius: 50%;

    background:
      linear-gradient(
        135deg,
        #0784f8,
        #32c8ff
      );

    color: #fff;

    font-size: 17px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .member-profile-summary strong {
    display: block;
    font-size: 14px;
    color: var(--d-text);
  }

  .member-profile-summary small {
    display: block;

    margin-top: 3px;

    font-size: 10px;
    color: var(--d-muted);

    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .member-top-welcome strong {
      font-size: 11px;
    }

    .member-top-welcome small {
      display: none;
    }

    .member-account-name {
      display: none;
    }

    .member-account-button {
      padding-right: 6px;
    }

    .member-account-dropdown {
      position: fixed;

      top: 58px;
      right: 10px;

      width: min(260px, calc(100vw - 20px));
    }
  }
</style>


