---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Create account — Trade Avata">
  <section class="auth-shell">
    <div class="auth-card">
      <span class="eyebrow">Get started</span>

      <h1>Create your account</h1>

      <p>
        Keep learning progress, purchases and Trade Avata workspace access
        connected to one account.
      </p>

      <button class="google-btn" type="button" data-google>
        G&nbsp;&nbsp; Sign up with Google
      </button>

      <div class="auth-divider">
        or create an account with email
      </div>

      <form class="form-grid" data-register>

        <label class="field">
          <span>Name</span>

          <input
            name="name"
            autocomplete="name"
            required
          />
        </label>

        <label class="field">
          <span>Email</span>

          <input
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </label>

        <label class="field">
          <span>Password</span>

          <div class="password-wrap">
            <input
              name="password"
              type="password"
              minlength="6"
              autocomplete="new-password"
              required
              data-password
            />

            <button
              class="password-toggle"
              type="button"
              data-toggle-password
              aria-label="Show password"
              aria-pressed="false"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="2.7"
                />
              </svg>
            </button>
          </div>
        </label>

        <label class="field">
          <span>Confirm Password</span>

          <div class="password-wrap">
            <input
              name="confirmPassword"
              type="password"
              minlength="6"
              autocomplete="new-password"
              required
              data-confirm-password
            />

            <button
              class="password-toggle"
              type="button"
              data-toggle-confirm
              aria-label="Show confirm password"
              aria-pressed="false"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="2.7"
                />
              </svg>
            </button>
          </div>

          <small
            data-password-match
            class="password-match"
          ></small>
        </label>

        <button
          class="button"
          type="submit"
        >
          Create account
        </button>

        <small
          data-status
          style="color:var(--muted)"
        ></small>
      </form>

      <div class="auth-links">
        <span>Already a member?</span>

        <a href={`${base}login/`}>
          Log in →
        </a>
      </div>
    </div>
  </section>

  <style>
    .password-wrap {
      position: relative;
      width: 100%;
    }

    .password-wrap input {
      width: 100%;
      padding-right: 52px;
    }

    /*
      Keep browser autofill using the Trade Avata theme.

      Light theme:
      light input + dark text + dark eye

      Dark theme:
      dark input + light text + light eye
    */
    .password-wrap input:-webkit-autofill,
    .password-wrap input:-webkit-autofill:hover,
    .password-wrap input:-webkit-autofill:focus,
    .password-wrap input:-webkit-autofill:active {
      -webkit-text-fill-color: var(--text) !important;
      -webkit-box-shadow:
        0 0 0 1000px var(--surface2) inset !important;
      box-shadow:
        0 0 0 1000px var(--surface2) inset !important;
      caret-color: var(--text);
      border-color: var(--line);
    }

    .password-toggle {
      position: absolute;
      right: 9px;
      top: 50%;
      transform: translateY(-50%);

      width: 36px;
      height: 36px;

      display: grid;
      place-items: center;

      border: 0;
      border-radius: 8px;

      background: transparent;

      /*
        This is what makes the eye adaptive.
        --text changes automatically with the website theme.
      */
      color: var(--text);

      cursor: pointer;
      padding: 0;

      opacity: 0.82;

      transition:
        background .15s ease,
        opacity .15s ease,
        transform .15s ease;
    }

    .password-toggle svg {
      width: 19px;
      height: 19px;

      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;

      pointer-events: none;
    }

    .password-toggle:hover {
      background: color-mix(
        in srgb,
        var(--text) 8%,
        transparent
      );

      opacity: 1;
    }

    .password-toggle:focus-visible {
      outline: 2px solid var(--blue);
      outline-offset: 1px;
      opacity: 1;
    }

    .password-toggle:active {
      transform:
        translateY(-50%)
        scale(.94);
    }

    .password-match {
      margin-top: 6px;
      min-height: 18px;
      display: block;
    }

    .password-match.good {
      color: var(--good);
    }

    .password-match.bad {
      color: var(--bad);
    }
  </style>

  <script>
    import {
      createUserWithEmailAndPassword,
      updateProfile,
      GoogleAuthProvider,
      signInWithPopup,
      sendEmailVerification
    } from 'firebase/auth';

    import { auth }
      from '../../lib/firebase/auth.js';

    import { ensureUserProfile }
      from '../../lib/firebase/db.js';

    const status =
      document.querySelector('[data-status]');

    const passwordInput =
      document.querySelector('[data-password]');

    const confirmPasswordInput =
      document.querySelector(
        '[data-confirm-password]'
      );

    const matchMessage =
      document.querySelector(
        '[data-password-match]'
      );

    const base =
      document.body.dataset.baseUrl || '/';


    /*
      PASSWORD VISIBILITY
    */

    function togglePassword(
      input,
      button
    ) {
      if (!input || !button) return;

      const isHidden =
        input.type === 'password';

      input.type =
        isHidden
          ? 'text'
          : 'password';

      button.setAttribute(
        'aria-label',
        isHidden
          ? 'Hide password'
          : 'Show password'
      );

      button.setAttribute(
        'aria-pressed',
        isHidden
          ? 'true'
          : 'false'
      );
    }


    document
      .querySelector(
        '[data-toggle-password]'
      )
      ?.addEventListener(
        'click',
        (event) => {
          togglePassword(
            passwordInput,
            event.currentTarget
          );
        }
      );


    document
      .querySelector(
        '[data-toggle-confirm]'
      )
      ?.addEventListener(
        'click',
        (event) => {
          togglePassword(
            confirmPasswordInput,
            event.currentTarget
          );
        }
      );


    /*
      PASSWORD MATCH CHECK
    */

    function checkPasswordMatch() {
      if (!matchMessage) return false;

      const password =
        passwordInput?.value || '';

      const confirmPassword =
        confirmPasswordInput?.value || '';

      matchMessage.classList.remove(
        'good',
        'bad'
      );

      if (!confirmPassword) {
        matchMessage.textContent = '';
        return false;
      }

      if (password === confirmPassword) {
        matchMessage.textContent =
          'Passwords match ✓';

        matchMessage.classList.add(
          'good'
        );

        return true;
      }

      matchMessage.textContent =
        'Passwords do not match';

      matchMessage.classList.add(
        'bad'
      );

      return false;
    }


    passwordInput?.addEventListener(
      'input',
      checkPasswordMatch
    );

    confirmPasswordInput?.addEventListener(
      'input',
      checkPasswordMatch
    );


    /*
      EMAIL REGISTRATION FINISH
    */

    async function finishEmailRegistration(
      user
    ) {
      try {
        await ensureUserProfile(user);

      } catch (error) {
        console.error(
          'Firestore profile error:',
          error
        );
      }


      try {
        await sendEmailVerification(user);

        location.href =
          `${base}verify-email/?sent=1`;

      } catch (error) {
        console.error(
          'Verification email error:',
          error
        );

        location.href =
          `${base}verify-email/?sendFailed=1`;
      }
    }


    /*
      EMAIL/PASSWORD REGISTRATION
    */

    document
      .querySelector('[data-register]')
      ?.addEventListener(
        'submit',
        async (event) => {
          event.preventDefault();

          if (!auth) {
            status.textContent =
              'Firebase Authentication is not available on this build.';

            return;
          }


          const form =
            new FormData(
              event.currentTarget
            );


          const name =
            String(
              form.get('name') || ''
            ).trim();


          const email =
            String(
              form.get('email') || ''
            ).trim();


          const password =
            String(
              form.get('password') || ''
            );


          const confirmPassword =
            String(
              form.get(
                'confirmPassword'
              ) || ''
            );


          /*
            STOP ACCOUNT CREATION
            WHEN PASSWORDS DIFFER
          */

          if (
            password !==
            confirmPassword
          ) {
            status.textContent =
              'Passwords do not match. Please check both password fields.';

            checkPasswordMatch();

            return;
          }


          if (password.length < 6) {
            status.textContent =
              'Password must contain at least 6 characters.';

            return;
          }


          status.textContent =
            'Creating account…';


          try {
            const credential =
              await createUserWithEmailAndPassword(
                auth,
                email,
                password
              );


            await updateProfile(
              credential.user,
              {
                displayName: name
              }
            );


            await finishEmailRegistration(
              credential.user
            );

          } catch (error) {
            console.error(
              'Registration error:',
              error
            );


            if (
              error?.code ===
              'auth/email-already-in-use'
            ) {
              status.textContent =
                'An account already exists with this email. Please log in instead.';

            } else if (
              error?.code ===
              'auth/weak-password'
            ) {
              status.textContent =
                'Please use a stronger password.';

            } else if (
              error?.code ===
              'auth/invalid-email'
            ) {
              status.textContent =
                'Please enter a valid email address.';

            } else {
              status.textContent =
                error?.message ||
                'Account creation failed.';
            }
          }
        }
      );


    /*
      GOOGLE REGISTRATION
    */

    document
      .querySelector('[data-google]')
      ?.addEventListener(
        'click',
        async () => {
          if (!auth) {
            status.textContent =
              'Firebase Authentication is not available on this build.';

            return;
          }


          status.textContent =
            'Opening Google sign-in…';


          try {
            const credential =
              await signInWithPopup(
                auth,
                new GoogleAuthProvider()
              );


            await ensureUserProfile(
              credential.user
            );


            location.href =
              `${base}member/`;

          } catch (error) {
            console.error(
              'Google sign-in error:',
              error
            );

            status.textContent =
              error?.message ||
              'Google sign-up failed.';
          }
        }
      );
  </script>
</BaseLayout>
