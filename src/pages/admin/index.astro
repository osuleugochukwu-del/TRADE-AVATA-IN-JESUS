---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { adminNav } from '../../data/admin-nav.js';

const base = import.meta.env.BASE_URL;
const nav = adminNav(base, 'overview');
---

<DashboardLayout
  title="Admin Dashboard — Trade Avata"
