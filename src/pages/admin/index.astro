---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { adminNav } from '../../data/admin-nav.js';
const base=import.meta.env.BASE_URL;
const nav=adminNav(base,'overview');
---

<DashboardLayout title="Admin Dashboard — Trade Avata" section="Admin" nav={nav} profile="Admin">
<Fragment slot="top-left"><span class="status-pill">● Platform online</span></Fragment>
<Fragment slot="top-right"><a class="dash-control" href={`${base}admin/homepage/`}>Quick Publish</a><a class="dash-control primary" href={`${base}admin/learn/`}>＋ Add Content</a></Fragment>

<div class="dash-head" id="overview"><div><span class="dash-eyebrow">ADMIN OVERVIEW</span><h1>Trade Avata Control Center</h1><p>Monitor the platform, manage access and move directly to the area that needs attention.</p></div></div>

<div class="metric-grid">
  <article class="metric"><span>Total Users</span><strong>12,482</strong><small class="good">+6.8% this month</small></article>
  <article class="metric"><span>Active Members</span><strong>4,921</strong><small>39% of users</small></article>
  <article class="metric"><span>Visitors Today</span><strong>2,184</strong><small class="good">+12% vs yesterday</small></article>
  <article class="metric"><span>Open Support</span><strong>18</strong><small class="bad">5 need reply</small></article>
  <article class="metric"><span>Product Sales</span><strong>$8,460</strong><small class="good">+9.4%</small></article>
  <article class="metric"><span>Course Enrollments</span><strong>684</strong><small>Last 30 days</small></article>
  <article class="metric"><span>Email Replies</span><strong>7</strong><small>Pending</small></article>
  <article class="metric"><span>System Health</span><strong class="good">Healthy</strong><small>All core services</small></article>
</div>

<div class="dash-grid two">
  <article class="dash-card" id="traffic">
    <div class="card-head"><h2>Traffic Overview</h2><div class="dash-tabs"><button class="active">30D</button><button>90D</button><button>1Y</button></div></div>
    <div class="dash-chart"></div>
  </article>
  <article class="dash-card" id="users">
    <div class="card-head"><h2>Recent Signups</h2><a href="#members" style="font-size:9px;color:#64b5ff">Manage members →</a></div>
    <div class="dash-list">
      <div class="dash-row"><span><b>Ada M.</b><small>Google · Member</small></span><span>2m</span></div>
      <div class="dash-row"><span><b>Samuel K.</b><small>Email · Member</small></span><span>18m</span></div>
      <div class="dash-row"><span><b>Peter O.</b><small>Email · Master request</small></span><span>1h</span></div>
    </div>
  </article>
</div>

<div class="dash-grid three" style="margin-top:10px">
  <article class="dash-card" id="members"><div class="card-head"><h2>Members</h2><span class="status-pill">4,921 active</span></div><div class="dash-row"><span><b>Course members</b><small>Learning access and progress</small></span><span>Review</span></div><div class="dash-row"><span><b>Product customers</b><small>Purchases and entitlements</small></span><span>Review</span></div></article>
  <article class="dash-card" id="support"><div class="card-head"><h2>Support Inbox</h2><span class="status-pill">18 open</span></div><div class="dash-row"><span><b>Indicator installation</b><small>Product support</small></span><span>Reply</span></div><div class="dash-row"><span><b>Course access</b><small>Member access</small></span><span>Reply</span></div><div class="dash-row"><span><b>Copy master capacity</b><small>Admin approval</small></span><span>Review</span></div></article>
  <article class="dash-card" id="email"><h2>Email Center</h2><div class="quick-actions"><a href={`${base}admin/email/`}>Compose message</a><a href={`${base}admin/email/`}>Template library</a><a href={`${base}admin/email-settings/`}>Email settings</a><a href={`${base}admin/email/`}>Campaigns & test</a></div></article>
  <article class="dash-card" id="homepage"><h2>Homepage & Banners</h2><div class="quick-actions"><a href={`${base}admin/homepage/`}>Promo banner</a><a href={`${base}admin/homepage/`}>Hero content</a><a href={`${base}admin/homepage/`}>Featured products</a><a href={`${base}admin/social/`}>Social media</a></div></article>
</div>

<div class="dash-grid three" style="margin-top:10px">
  <article class="dash-card" id="products"><h2>Products / Indicators</h2><div class="dash-row"><span><b>10 visible products</b><small>4 featured on homepage</small></span><span class="good">Live</span></div><div class="dash-row"><span><b>2 pending updates</b><small>Files not published</small></span><span>Review</span></div></article>
  <article class="dash-card" id="courses"><h2>Courses</h2><div class="dash-row"><span><b>6 published courses</b><small>684 enrollments</small></span><span>Manage</span></div><div class="dash-row"><span><b>3 draft lessons</b><small>Not visible to members</small></span><span>Edit</span></div></article>
  <article class="dash-card" id="copy"><h2>Copy Trading</h2><div class="dash-row"><span><b>14 approved masters</b><small>128 connected follower accounts</small></span><span class="good">Stable</span></div><div class="dash-row"><span><b>3 access requests</b><small>Awaiting review</small></span><span>Review</span></div></article>
</div>

<div class="dash-grid three" style="margin-top:10px">
  <article class="dash-card" id="analytics"><h2>Analytics Accounts</h2><div class="dash-row"><span><b>Connected / demo workspaces</b><small>Manage account access and data status</small></span><span>Review</span></div></article>
  <article class="dash-card" id="journal"><h2>Journal Oversight</h2><div class="dash-row"><span><b>Workspace sync</b><small>Review storage and account access</small></span><span class="good">Normal</span></div></article>
  <article class="dash-card" id="sales"><h2>Orders & Sales</h2><div class="dash-row"><span><b>Recent orders</b><small>Products, courses and access</small></span><span>Manage</span></div></article>
</div>

<div class="dash-grid three" style="margin-top:10px">
  <article class="dash-card" id="content"><h2>Content & Pages</h2><div class="quick-actions"><a href={`${base}admin/homepage/`}>Homepage editor</a><a href={`${base}admin/learn/`}>Learning manager</a><a href={`${base}admin/homepage/`}>Page visibility</a><a href={`${base}admin/learn/`}>Learning media</a></div></article>
  <article class="dash-card" id="payments"><h2>Payments & Integrations</h2><div class="dash-row"><span>Payment provider</span><b>Not connected</b></div><div class="dash-row"><span>Firebase</span><b>Environment based</b></div><div class="dash-row"><span>Email routing</span><b>Configure later</b></div></article>
  <article class="dash-card" id="roles"><h2>Roles & Permissions</h2><div class="dash-row"><span>Admins</span><b>1</b></div><div class="dash-row"><span>Approved Masters</span><b>14</b></div><div class="dash-row"><span>Members</span><b>4,921</b></div></article>
</div>

<div class="dash-grid two" style="margin-top:10px">
  <article class="dash-card" id="reports"><h2>Reports & Exports</h2><div class="quick-actions"><button class="dash-control">User report</button><button class="dash-control">Sales report</button><button class="dash-control">Support report</button><button class="dash-control">Copy Trading report</button></div></article>
  <article class="dash-card" id="settings"><div class="card-head"><h2>Platform Settings</h2><button class="dash-control">Open Settings</button></div><p>Brand, access, integrations, notifications and operational preferences are kept here instead of crowding the overview.</p></article>
</div>

<article class="dash-card" style="margin-top:10px" id="logs">
  <div class="card-head"><h2>Recent Platform Activity</h2><button class="dash-control">Export log</button></div>
  <div class="dash-table-wrap">
    <table class="dash-table">
      <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Area</th><th>Status</th></tr></thead>
      <tbody>
        <tr><td>10:42</td><td>Admin</td><td>Updated homepage banner</td><td>Content</td><td class="good">Success</td></tr>
        <tr><td>10:18</td><td>System</td><td>Course progress sync</td><td>Members</td><td class="good">Success</td></tr>
        <tr><td>09:55</td><td>Admin</td><td>Approved copy master capacity</td><td>Copy Trading</td><td class="good">Success</td></tr>
      </tbody>
    </table>
  </div>
</article>
</DashboardLayout>
