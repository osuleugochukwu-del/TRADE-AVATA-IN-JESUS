<script>
  import {
    getIdTokenResult
  } from 'firebase/auth';

  import {
    auth,
    onAuthStateChanged
  } from '../../lib/firebase/auth.js';


  const base =
    document.body?.dataset?.baseUrl || '/';

  const dashboard =
    document.querySelector(
      '[data-admin-dashboard]'
    );

  const status =
    document.querySelector(
      '[data-admin-status]'
    );


  function redirectUnauthorized() {
    location.replace(
      `${base}member/`
    );
  }


  if (!auth) {

    redirectUnauthorized();

  } else {

    onAuthStateChanged(
      auth,
      async user => {

        if (!user) {
          location.replace(
            `${base}login/?redirect=admin`
          );

          return;
        }


        try {

          const tokenResult =
            await getIdTokenResult(
              user,
              true
            );

          const claims =
            tokenResult.claims || {};


          const isSuperAdmin =
            claims.superAdmin === true ||
            claims.role === 'superAdmin';


          const isAdmin =
            claims.admin === true ||
            claims.role === 'admin';


          if (
            !isSuperAdmin &&
            !isAdmin
          ) {

            redirectUnauthorized();
            return;
          }


          if (status) {

            status.textContent =
              isSuperAdmin
                ? '● Super Admin'
                : '● Administrator';

          }


          if (dashboard) {
            dashboard.hidden = false;
          }


        } catch (error) {

          console.error(
            'Admin verification error:',
            error
          );

          redirectUnauthorized();

        }

      }
    );

  }
</script>
