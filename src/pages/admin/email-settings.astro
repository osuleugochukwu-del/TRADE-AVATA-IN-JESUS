---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { adminNav } from '../../data/admin-nav.js';
const base=import.meta.env.BASE_URL;
const nav=adminNav(base,'email');
---
<DashboardLayout title="Email Settings — Trade Avata Admin" section="Admin" nav={nav} profile="Admin">
  <Fragment slot="top-left"><span class="status-pill">Email provider settings</span></Fragment>
  <Fragment slot="top-right"><a class="dash-control" href={`${base}admin/email/`}>Template Library</a></Fragment>
  <div class="dash-head"><div><span class="dash-eyebrow">COMMUNICATIONS</span><h1>Email Settings</h1><p>Configure sender identities and email behaviour. Provider secrets stay server-side and never appear in Firestore.</p></div></div>
  <div class="dash-grid two email-settings-grid"><section class="dash-card"><form data-form>
    <div class="settings-grid"><label>Provider<select name="provider"><option value="none">Not connected yet</option><option value="smtp">SMTP</option><option value="resend">Resend</option></select></label><label>From name<input name="fromName" placeholder="Trade Avata"></label><label>From email<input name="fromEmail" placeholder="email@your-domain.com"></label><label>Reply-to<input name="replyTo" placeholder="Optional"></label><label>Support email<input name="supportEmail" placeholder="support@your-domain.com"></label><label>Admin notification email<input name="adminEmail" placeholder="admin@your-domain.com"></label><label class="full">Website URL<input name="appUrl" placeholder="https://your-domain.example"></label><label>Transactional emails<select name="enabled"><option value="false">Disabled / queue-only</option><option value="true">Enabled</option></select></label><label>Dry-run mode<select name="dryRun"><option value="true">On — do not send</option><option value="false">Off — provider may send</option></select></label></div>
    <div class="secure-note"><b>Security boundary</b><span>SMTP passwords, Resend API keys and other credentials belong in server-side environment/secrets only. The Admin dashboard never stores them.</span></div>
    <div class="settings-actions"><button class="dash-control primary" type="submit">Save settings</button><button class="dash-control" type="button" data-test>Check configuration</button><span data-status></span></div>
  </form></section><aside class="dash-card"><h2>How this works</h2><div class="dash-row"><span><b>1. Frontend templates</b><small>Create and edit branded templates in Email Center.</small></span><span>Ready</span></div><div class="dash-row"><span><b>2. Firestore queue</b><small>Campaigns and transactional messages are queued securely.</small></span><span>Ready</span></div><div class="dash-row"><span><b>3. Email provider</b><small>Connect SMTP or Resend when your domain/email is ready.</small></span><span>Later</span></div><div class="dash-row"><span><b>4. Trade Avata branding</b><small>Every managed template uses the official mark, Trade Avata and Trade Simple.</small></span><span class="good">Included</span></div></aside></div>
</DashboardLayout>
<script>
import { doc, getDoc, setDoc, serverTimestamp } from 'firebase/firestore';
import { watchAuth } from '../../lib/firebase/auth.js';
import { db } from '../../lib/firebase/db.js';
import { getAdminRole, writeAdminAudit } from '../../lib/firebase/admin.js';
const form=document.querySelector('[data-form]'),status=document.querySelector('[data-status]');let actorId=null;
const fields=['provider','fromName','fromEmail','replyTo','supportEmail','adminEmail','appUrl','enabled','dryRun'];
const setFields=(data={})=>fields.forEach(k=>{if(!form.elements[k])return;const fallback=k==='provider'?'none':k==='enabled'?'false':k==='dryRun'?'true':'';form.elements[k].value=String(data[k]??fallback)});
async function load(){if(!db){status.textContent='Firebase is not configured yet. Settings can be entered after connection.';return;}const snap=await getDoc(doc(db,'siteSettings','email'));setFields(snap.exists()?snap.data():{})}
form.addEventListener('submit',async e=>{e.preventDefault();if(!db||!actorId){status.textContent='Administrator Firebase access is required to publish these settings.';return;}const v=Object.fromEntries(new FormData(form));v.enabled=v.enabled==='true';v.dryRun=v.dryRun==='true';try{await setDoc(doc(db,'siteSettings','email'),{...v,updatedAt:serverTimestamp()},{merge:true});await writeAdminAudit({actorId,action:'save',target:'emailSettings'});status.textContent='Email settings saved. Provider secrets remain server-side.';}catch(error){status.textContent=error?.message||'Unable to save.'}});
document.querySelector('[data-test]').addEventListener('click',()=>{const provider=form.elements.provider.value,from=form.elements.fromEmail.value.trim(),enabled=form.elements.enabled.value==='true',dry=form.elements.dryRun.value==='true';status.textContent=provider==='none'?'No provider selected. Queue-only mode is safe for frontend testing.':!from?'Add a sender email before enabling delivery.':!enabled?'Provider selected, but transactional sending is disabled.':dry?'Configuration is set to dry-run; messages will not leave the server.':'Frontend settings look ready. Server credentials still determine whether the provider can send.'});
watchAuth(async user=>{if(!user){status.textContent='Sign in as an administrator to load/publish email settings.';return;}const role=await getAdminRole(user.uid);if(!role){status.textContent='Administrator access is required.';return;}actorId=user.uid;await load()});
</script>
<style>.email-settings-grid{align-items:start}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.settings-grid label{display:grid;gap:5px;font-size:9px;color:var(--d-muted)}.settings-grid .full{grid-column:1/-1}.settings-grid input,.settings-grid select{width:100%;padding:9px 10px;border:1px solid var(--d-border);border-radius:8px;background:var(--d-panel2);color:var(--d-text)}.secure-note{display:grid;gap:5px;margin-top:14px;padding:13px;border:1px solid var(--d-border);border-radius:9px;background:var(--d-panel2)}.secure-note span{font-size:9px;color:var(--d-muted)}.settings-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:14px}.settings-actions span{font-size:9px;color:var(--d-muted)}@media(max-width:640px){.settings-grid{grid-template-columns:1fr}.settings-grid .full{grid-column:auto}}</style>
