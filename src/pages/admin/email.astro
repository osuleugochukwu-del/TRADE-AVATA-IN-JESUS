---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { adminNav } from '../../data/admin-nav.js';
const base=import.meta.env.BASE_URL;
const nav=adminNav(base,'email');
---
<DashboardLayout title="Email Center — Trade Avata Admin" section="Admin" nav={nav} profile="Admin">
  <Fragment slot="top-left"><span class="status-pill">Email templates & campaigns</span></Fragment>
  <Fragment slot="top-right"><a class="dash-control" href={`${base}admin/email-settings/`}>Email Settings</a></Fragment>
  <div class="dash-head"><div><span class="dash-eyebrow">COMMUNICATIONS</span><h1>Email Center</h1><p>Manage branded Trade Avata templates, test them, and queue campaigns without editing code.</p></div><div class="email-head-actions"><button class="dash-control" data-install>Install defaults</button><button class="dash-control primary" data-new>＋ New template</button></div></div>
  <div class="email-workspace">
    <aside class="dash-card email-library"><div class="card-head"><h2>Template Library</h2><span data-count>0</span></div><div class="email-search"><input data-search placeholder="Search templates…"></div><div data-templates class="template-list"></div></aside>
    <section class="dash-card email-editor">
      <form data-form>
        <input type="hidden" name="key">
        <div class="editor-head"><div><span class="dash-eyebrow" data-category-label>ACCOUNT</span><h2 data-template-title>Template</h2></div><label class="toggle-label"><input type="checkbox" name="enabled" checked> Enabled</label></div>
        <div class="email-form-grid two"><label>Template name<input name="name" required></label><label>Category<select name="category"><option>Account</option><option>Security</option><option>Orders</option><option>Products</option><option>Learning</option><option>Support</option><option>Copy Trading</option><option>Platform</option><option>Campaigns</option></select></label></div>
        <label>Subject<input name="subject" required></label>
        <label>Preheader<input name="preheader" placeholder="Short inbox preview text"></label>
        <label>Headline<input name="headline" required></label>
        <label>Body<textarea name="body" rows="7" required></textarea></label>
        <div class="email-form-grid two"><label>Button label<input name="ctaLabel" placeholder="Optional"></label><label>Button URL<input name="ctaUrl" placeholder="{{appUrl}}/member/"></label></div>
        <label>Footer line<input name="footer" placeholder="Trade Avata · Trade Simple."></label>
        <div class="variables"><b>Available variables</b><div data-variables></div></div>
        <div class="editor-actions"><button class="dash-control primary" type="submit">Save template</button><button class="dash-control" type="button" data-duplicate>Duplicate</button><button class="dash-control" type="button" data-preview-button>Refresh preview</button></div>
      </form>
      <div data-status class="email-status"></div>
    </section>
    <aside class="dash-card email-preview-card"><div class="card-head"><h2>Branded Preview</h2><span>Trade Avata</span></div><div class="email-preview" data-preview></div><div class="test-panel"><label>Test recipient<input data-test-email type="email" placeholder="you@example.com"></label><button class="dash-control" data-test>Send test</button></div></aside>
  </div>
  <section class="dash-card campaign-card"><div class="card-head"><div><h2>Campaign Send</h2><p>Queue the selected template for a controlled audience.</p></div></div><div class="campaign-grid"><label>Audience<select data-audience><option value="all">All registered users</option><option value="students">Students</option><option value="selected">Selected emails</option></select></label><label data-recipient-wrap hidden>Selected emails<textarea data-recipient rows="2" placeholder="person@example.com, another@example.com"></textarea></label><button class="dash-control primary" data-send>Queue campaign</button><span data-campaign-status></span></div></section>
</DashboardLayout>
<script>
import { collection, doc, getDoc, getDocs, query, orderBy, limit, setDoc, serverTimestamp, writeBatch, addDoc } from 'firebase/firestore';
import { db } from '../../lib/firebase/db.js';
import { watchAuth } from '../../lib/firebase/auth.js';
import { getAdminRole, writeAdminAudit } from '../../lib/firebase/admin.js';
import { defaultEmailTemplates, emailTemplateVariables, substituteTemplateVariables } from '../../data/email-templates.js';
let actorId=null,templates=[],selectedKey=null;
const form=document.querySelector('[data-form]'),list=document.querySelector('[data-templates]'),status=document.querySelector('[data-status]'),campaignStatus=document.querySelector('[data-campaign-status]');
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const draftKey='ta-email-template-drafts';
const sample={firstName:'Henry',displayName:'Henry',email:'trader@example.com',appUrl:'https://tradeavata.com',supportEmail:'support@tradeavata.com',orderNumber:'TA-1048',amount:'89.00',currency:'USD',productName:'Trade Avata Pro Trend',courseName:'Technical Analysis Mastery',certificateUrl:'#',resetUrl:'#',verificationUrl:'#',ticketNumber:'SUP-218',masterName:'Henry',capacity:'25',actionUrl:'#'};
function draftMap(){try{return JSON.parse(localStorage.getItem(draftKey)||'{}')}catch{return {}}}function saveDraftMap(map){localStorage.setItem(draftKey,JSON.stringify(map))}
function values(){const v=Object.fromEntries(new FormData(form));v.enabled=form.elements.enabled.checked;return v}
function normalize(x={}){return {key:x.key||`custom-${Date.now()}`,name:x.name||'New Template',category:x.category||'Platform',subject:x.subject||'Trade Avata notification',preheader:x.preheader||'',headline:x.headline||x.name||'Trade Avata',body:x.body||'Hello {{firstName}},',ctaLabel:x.ctaLabel||'',ctaUrl:x.ctaUrl||'',footer:x.footer||'Trade Avata · Trade Simple.',enabled:x.enabled!==false,audience:x.audience||'transactional'}}
function fill(x){const v=normalize(x);selectedKey=v.key;for(const [k,val] of Object.entries(v)){const el=form.elements[k];if(!el)continue;if(el.type==='checkbox')el.checked=Boolean(val);else el.value=val??''}document.querySelector('[data-template-title]').textContent=v.name;document.querySelector('[data-category-label]').textContent=v.category.toUpperCase();renderPreview()}
function renderList(){const q=String(document.querySelector('[data-search]').value||'').toLowerCase();const filtered=templates.filter(x=>`${x.name} ${x.category} ${x.subject}`.toLowerCase().includes(q));document.querySelector('[data-count]').textContent=String(templates.length);list.innerHTML=filtered.map(x=>`<button type="button" data-key="${esc(x.key)}" class="${x.key===selectedKey?'active':''}"><span><b>${esc(x.name)}</b><small>${esc(x.category)} · ${x.enabled===false?'Disabled':'Enabled'}</small></span><em>›</em></button>`).join('')||'<p class="empty">No templates match.</p>';list.querySelectorAll('[data-key]').forEach(b=>b.addEventListener('click',()=>{fill(templates.find(x=>x.key===b.dataset.key));renderList()}))}
function renderPreview(){const v=values();const subject=substituteTemplateVariables(v.subject,sample),headline=substituteTemplateVariables(v.headline,sample),body=substituteTemplateVariables(v.body,sample),pre=substituteTemplateVariables(v.preheader,sample),cta=substituteTemplateVariables(v.ctaLabel,sample),url=substituteTemplateVariables(v.ctaUrl,sample),footer=substituteTemplateVariables(v.footer,sample);document.querySelector('[data-preview]').innerHTML=`<div class="mail-shell"><div class="mail-brand"><img src="${location.origin}${document.body.dataset.baseUrl||'/'}brand/trade-avata-mark.png" alt=""><span><strong>Trade Avata</strong><small>Trade Simple.</small></span></div><small class="mail-pre">${esc(pre)}</small><h3>${esc(headline)}</h3><div class="mail-body">${esc(body).replace(/\n/g,'<br>')}</div>${cta?`<a href="${esc(url||'#')}">${esc(cta)}</a>`:''}<footer>${esc(footer)}</footer><div class="mail-subject">Subject: ${esc(subject)}</div></div>`}
async function load(){const map=draftMap();let remote=[];if(db&&actorId){try{const snap=await getDocs(query(collection(db,'emailTemplates'),orderBy('updatedAt','desc'),limit(150)));remote=snap.docs.map(d=>({key:d.id,...d.data()}))}catch{}}const merged=new Map(defaultEmailTemplates.map(x=>[x.key,{...x}]));Object.values(map).forEach(x=>merged.set(x.key,{...merged.get(x.key),...x}));remote.forEach(x=>merged.set(x.key,{...merged.get(x.key),...x}));templates=[...merged.values()];fill(templates[0]);renderList()}
form.addEventListener('input',renderPreview);form.addEventListener('change',renderPreview);form.addEventListener('submit',async e=>{e.preventDefault();const v=normalize(values());v.key=String(v.key||selectedKey||`custom-${Date.now()}`).trim().replace(/[^a-zA-Z0-9_-]/g,'-');selectedKey=v.key;const map=draftMap();map[v.key]=v;saveDraftMap(map);const i=templates.findIndex(x=>x.key===v.key);if(i>=0)templates[i]={...templates[i],...v};else templates.unshift(v);renderList();if(!db||!actorId){status.textContent='Saved on this device. Sign in with Firebase Admin access to publish it to the backend.';return;}try{await setDoc(doc(db,'emailTemplates',v.key),{...v,updatedAt:serverTimestamp(),updatedBy:actorId},{merge:true});await writeAdminAudit({actorId,action:'save',target:'emailTemplate',targetId:v.key});status.textContent='Template saved to Trade Avata backend.';}catch(error){status.textContent=error?.message||'Unable to save.'}});
document.querySelector('[data-new]').addEventListener('click',()=>{fill(normalize({key:`custom-${Date.now()}`,name:'New Template'}));renderList()});
document.querySelector('[data-duplicate]').addEventListener('click',()=>{const v=normalize(values());v.key=`${v.key||'template'}-copy-${Date.now()}`;v.name=`${v.name} Copy`;fill(v);renderList()});
document.querySelector('[data-preview-button]').addEventListener('click',renderPreview);
document.querySelector('[data-search]').addEventListener('input',renderList);
document.querySelector('[data-variables]').innerHTML=emailTemplateVariables.map(x=>`<button type="button" data-variable="${esc(x)}">${esc(x)}</button>`).join('');document.querySelectorAll('[data-variable]').forEach(b=>b.addEventListener('click',()=>{const target=form.elements.body;const start=target.selectionStart??target.value.length;target.value=target.value.slice(0,start)+b.dataset.variable+target.value.slice(target.selectionEnd??start);target.focus();renderPreview()}));
document.querySelector('[data-install]').addEventListener('click',async()=>{const map=draftMap();defaultEmailTemplates.forEach(x=>map[x.key]={...x});saveDraftMap(map);if(!db||!actorId){status.textContent='Default template library installed on this device. Connect Firebase/Admin to publish it.';await load();return;}try{let batch=writeBatch(db),count=0;for(const x of defaultEmailTemplates){batch.set(doc(db,'emailTemplates',x.key),{...x,updatedAt:serverTimestamp(),updatedBy:actorId},{merge:true});count++;if(count===400){await batch.commit();batch=writeBatch(db);count=0}}if(count)await batch.commit();await writeAdminAudit({actorId,action:'install_defaults',target:'emailTemplates',metadata:{count:defaultEmailTemplates.length}});status.textContent=`Installed ${defaultEmailTemplates.length} branded templates.`;await load()}catch(error){status.textContent=error?.message||'Unable to install defaults.'}});
document.querySelector('[data-test]').addEventListener('click',async()=>{const to=String(document.querySelector('[data-test-email]').value||'').trim();if(!to){status.textContent='Enter a test recipient email.';return;}if(!db||!actorId){status.textContent='Firebase Admin access is required to queue a test email.';return;}const v=normalize(values());try{await setDoc(doc(db,'emailTemplates',v.key),{...v,updatedAt:serverTimestamp(),updatedBy:actorId},{merge:true});await addDoc(collection(db,'mail'),{to,type:'test',templateKey:v.key,variables:{...sample,email:to},createdAt:serverTimestamp(),createdBy:actorId});status.textContent='Test email queued. Delivery depends on Email Settings/provider configuration.';}catch(error){status.textContent=error?.message||'Unable to queue test.'}});
const audience=document.querySelector('[data-audience]');audience.addEventListener('change',()=>document.querySelector('[data-recipient-wrap]').hidden=audience.value!=='selected');
document.querySelector('[data-send]').addEventListener('click',async()=>{if(!selectedKey){campaignStatus.textContent='Choose a template first.';return;}if(!db||!actorId){campaignStatus.textContent='Firebase Admin access is required to queue a campaign.';return;}if(!confirm('Queue this template for the selected audience?'))return;try{const usersSnap=await getDocs(collection(db,'users'));let recipients=usersSnap.docs.map(d=>({id:d.id,...d.data()})).filter(x=>x.email);if(audience.value==='selected'){const emails=String(document.querySelector('[data-recipient]').value||'').split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);recipients=recipients.filter(x=>emails.includes(String(x.email).toLowerCase()))}if(audience.value==='students'){const enrollSnap=await getDocs(collection(db,'enrollments'));const ids=new Set(enrollSnap.docs.map(d=>d.data().userId).filter(Boolean));recipients=recipients.filter(x=>ids.has(x.id))}const campaign=await addDoc(collection(db,'emailCampaigns'),{templateKey:selectedKey,audience:audience.value,status:'queued',recipientCount:recipients.length,createdBy:actorId,createdAt:serverTimestamp()});let batch=writeBatch(db),count=0;for(const recipient of recipients){batch.set(doc(collection(db,'mail')),{to:recipient.email,type:'campaign',templateKey:selectedKey,variables:{firstName:recipient.displayName||'Trader',displayName:recipient.displayName||'',email:recipient.email,appUrl:location.origin+(document.body.dataset.baseUrl||'/')},campaignId:campaign.id,createdAt:serverTimestamp(),createdBy:actorId});count++;if(count===400){await batch.commit();batch=writeBatch(db);count=0}}if(count)await batch.commit();await writeAdminAudit({actorId,action:'send',target:'emailCampaign',targetId:campaign.id,metadata:{recipientCount:recipients.length,audience:audience.value,templateKey:selectedKey}});campaignStatus.textContent=`Queued ${recipients.length} email(s).`;}catch(error){campaignStatus.textContent=error?.message||'Unable to queue campaign.'}});
watchAuth(async user=>{if(!user){status.textContent='Sign in as an administrator to publish/send. You can still edit local drafts.';await load();return;}const role=await getAdminRole(user.uid);if(!role){status.textContent='Administrator access is required to publish/send.';await load();return;}actorId=user.uid;await load()});
load();
</script>
<style>
.email-head-actions{display:flex;gap:8px}.email-workspace{display:grid;grid-template-columns:270px minmax(0,1fr) 350px;gap:10px;align-items:start}.email-library,.email-editor,.email-preview-card{min-height:660px}.email-search input,.email-editor input,.email-editor select,.email-editor textarea,.test-panel input,.campaign-card input,.campaign-card select,.campaign-card textarea{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid var(--d-border);border-radius:8px;background:var(--d-panel2);color:var(--d-text)}.email-search{margin:10px 0}.template-list{display:grid;gap:5px;max-height:560px;overflow:auto}.template-list button{display:flex;align-items:center;justify-content:space-between;text-align:left;padding:10px;border:1px solid transparent;border-radius:9px;background:transparent;color:var(--d-text)}.template-list button:hover,.template-list button.active{background:var(--d-panel2);border-color:var(--d-border)}.template-list b,.template-list small{display:block}.template-list small{margin-top:3px;font-size:9px;color:var(--d-muted)}.template-list em{font-style:normal;color:var(--d-muted)}.empty{color:var(--d-muted);font-size:10px}.editor-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px}.toggle-label{display:flex!important;align-items:center;gap:7px!important}.toggle-label input{width:auto}.email-editor label,.test-panel label,.campaign-grid label{display:grid;gap:5px;margin-bottom:10px;font-size:10px;color:var(--d-muted)}.email-form-grid{display:grid;gap:8px}.email-form-grid.two{grid-template-columns:1fr 1fr}.variables{padding:10px;border:1px solid var(--d-border);border-radius:9px;background:var(--d-panel2)}.variables b{display:block;font-size:9px;margin-bottom:7px}.variables div{display:flex;gap:5px;flex-wrap:wrap}.variables button{border:1px solid var(--d-border);border-radius:999px;background:var(--d-panel);color:var(--d-muted);font-size:8px;padding:5px 7px}.editor-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.email-status{font-size:10px;color:var(--d-muted);margin-top:10px}.email-preview{padding:10px;background:#dfe8f1;border-radius:10px;min-height:465px}.mail-shell{background:#fff;color:#16304a;border-radius:8px;padding:18px;font-family:Arial,sans-serif}.mail-brand{display:flex;align-items:center;gap:9px;margin-bottom:20px}.mail-brand img{width:38px;height:38px}.mail-brand span{display:grid}.mail-brand strong{font-size:16px}.mail-brand small{font-size:9px;color:#5c7891;margin-top:3px}.mail-pre{color:#7a8b9a}.mail-shell h3{font-size:22px;margin:8px 0 14px}.mail-body{font-size:12px;line-height:1.65;color:#51687c}.mail-shell>a{display:inline-block;margin:16px 0 8px;padding:10px 13px;border-radius:8px;background:#0c84fa;color:#fff;text-decoration:none;font-size:11px;font-weight:700}.mail-shell footer{border-top:1px solid #e4ebf1;margin-top:20px;padding-top:12px;color:#8292a0;font-size:9px}.mail-subject{margin-top:12px;padding:8px;background:#f3f6f9;border-radius:6px;font-size:8px;color:#6c7f91}.test-panel{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end;margin-top:12px}.test-panel label{margin:0}.campaign-card{margin-top:10px}.campaign-grid{display:grid;grid-template-columns:minmax(180px,260px) minmax(280px,1fr) auto minmax(130px,1fr);gap:10px;align-items:end}.campaign-grid label{margin:0}.campaign-grid span{font-size:10px;color:var(--d-muted);align-self:center}@media(max-width:1180px){.email-workspace{grid-template-columns:250px 1fr}.email-preview-card{grid-column:1/-1;min-height:auto}.email-preview{min-height:0}.campaign-grid{grid-template-columns:1fr 1fr}}@media(max-width:760px){.email-workspace{grid-template-columns:1fr}.email-library,.email-editor{min-height:auto}.email-form-grid.two,.campaign-grid{grid-template-columns:1fr}.email-head-actions{margin-top:10px;flex-wrap:wrap}.test-panel{grid-template-columns:1fr}}
</style>
