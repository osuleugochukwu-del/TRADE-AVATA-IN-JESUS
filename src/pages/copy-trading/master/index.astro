---
import DashboardLayout from '../../../layouts/DashboardLayout.astro'; const base=import.meta.env.BASE_URL;
const nav=[{label:'Overview',icon:'⌂',href:'#overview',active:true},{label:'Follower Accounts',icon:'◎',href:'#followers'},{label:'Open Trades',icon:'↗',href:'#trades'},{label:'Copy History',icon:'▤',href:'#history'},{label:'Risk & Allocation',icon:'△',href:'#risk'},{label:'Health & Errors',icon:'!',href:'#health'},{label:'Capacity',icon:'▦',href:'#capacity'},{label:'Reports',icon:'⇩',href:'#reports'},{label:'Audit Log',icon:'◷',href:'#audit'},{label:'Settings',icon:'⚙',href:'#settings'}];
---
<DashboardLayout title="Copy Trading Master — Trade Avata" section="Copy Trading" nav={nav} profile="Master"><Fragment slot="top-left"><select><option>Master Account · cTrader</option><option>Backup Master · MT5</option></select><span class="status-pill">● Copier online</span></Fragment><Fragment slot="top-right"><button class="dash-control" data-pause>Pause Copier</button><button class="dash-control primary">＋ Add Follower</button></Fragment>
<div class="dash-head" id="overview"><div><span class="dash-eyebrow">MASTER WORKSPACE</span><h1>Copy Trading Dashboard</h1><p>Manage connected accounts, risk, copy health and activity from one controlled workspace.</p></div></div>
<div class="metric-grid"><article class="metric"><span>Connected Followers</span><strong>18</strong><small>of 25 allowed</small></article><article class="metric"><span>Copier Status</span><strong class="good">Running</strong><small>All systems normal</small></article><article class="metric"><span>Trades Copied Today</span><strong>42</strong><small class="good">98.6% success</small></article><article class="metric"><span>Average Latency</span><strong>184ms</strong><small>Across active followers</small></article></div>
<div class="dash-grid two"><article class="dash-card" id="followers"><div class="card-head"><h2>Follower Account Health</h2><button class="dash-control">Manage Accounts</button></div><div class="dash-list"><div class="dash-row"><span><b>Challenge Alpha</b><small>MT5 · 1.0x multiplier</small></span><span class="good">Connected</span></div><div class="dash-row"><span><b>Demo Test 04</b><small>cTrader · 0.7x multiplier</small></span><span class="good">Connected</span></div><div class="dash-row"><span><b>Prop Beta</b><small>MT5 · Fixed 0.50%</small></span><span class="bad">Reconnect</span></div><div class="dash-row"><span><b>Personal 2</b><small>cTrader · 1.0x multiplier</small></span><span class="good">Connected</span></div></div></article><article class="dash-card" id="capacity"><h2>Capacity</h2><div class="metric" style="margin-bottom:8px"><span>Used</span><strong>18 / 25</strong><small>7 follower slots available</small></div><div class="dash-row"><span>Master access</span><b class="good">Approved</b></div><div class="dash-row"><span>Plan</span><b>25-account capacity</b></div><div class="dash-row"><span>Billing state</span><b>Manual / Active</b></div></article></div>
<div class="dash-grid three" style="margin-top:10px"><article class="dash-card" id="risk"><h2>Risk & Allocation</h2><div class="dash-row"><span>Default mode</span><b>Multiplier</b></div><div class="dash-row"><span>Max copy risk</span><b>1.00%</b></div><div class="dash-row"><span>Max daily loss guard</span><b>3.00%</b></div><button class="dash-control">Edit Risk Rules</button></article><article class="dash-card" id="health"><h2>Health & Errors</h2><div class="dash-row"><span>Healthy connections</span><b class="good">17</b></div><div class="dash-row"><span>Needs attention</span><b class="bad">1</b></div><div class="dash-row"><span>Failed copies today</span><b>1</b></div><button class="dash-control">View Diagnostics</button></article><article class="dash-card"><h2>Recent Activity</h2><div class="dash-row"><span><b>EURUSD BUY copied</b><small>17/18 accounts</small></span><span>1m</span></div><div class="dash-row"><span><b>XAUUSD SELL closed</b><small>18/18 accounts</small></span><span>14m</span></div><div class="dash-row"><span><b>Prop Beta disconnected</b><small>Retry scheduled</small></span><span>21m</span></div></article></div>
<article class="dash-card" id="trades" style="margin-top:10px"><div class="card-head"><h2>Copied Trades</h2><div class="dash-tabs"><button class="active">Open</button><button>Closed</button><button>Failed</button></div></div><div class="dash-table-wrap"><table class="dash-table"><thead><tr><th>Time</th><th>Symbol</th><th>Side</th><th>Master Volume</th><th>Followers</th><th>Success</th><th>Latency</th><th>Status</th></tr></thead><tbody><tr><td>10:42</td><td>EURUSD</td><td>BUY</td><td>0.50</td><td>18</td><td>17/18</td><td>176ms</td><td class="good">Open</td></tr><tr><td>10:11</td><td>XAUUSD</td><td>SELL</td><td>0.20</td><td>18</td><td>18/18</td><td>194ms</td><td>Closed</td></tr></tbody></table></div></article>

<div class="dash-grid three" style="margin-top:10px"><article class="dash-card" id="history"><h2>Copy History</h2><div class="dash-row"><span>Last 24 hours</span><b>118 copy events</b></div><div class="dash-row"><span>Successful</span><b class="good">116</b></div><div class="dash-row"><span>Failed / skipped</span><b class="bad">2</b></div></article><article class="dash-card" id="reports"><h2>Reports</h2><div class="quick-actions"><button>Copy performance CSV</button><button>Follower status report</button><button>Error report</button><button>Monthly summary</button></div></article><article class="dash-card" id="settings"><h2>Master Settings</h2><div class="dash-row"><span>Copy on reconnect</span><b>Enabled</b></div><div class="dash-row"><span>Trade close sync</span><b>Enabled</b></div><div class="dash-row"><span>Emergency stop</span><b>Available</b></div></article></div>
<article class="dash-card" id="audit" style="margin-top:10px"><h2>Audit Log</h2><div class="dash-row"><span><b>Risk rule updated</b><small>Master workspace</small></span><span>Today 09:42</span></div><div class="dash-row"><span><b>Follower disabled</b><small>Prop Beta</small></span><span>Yesterday</span></div></article>
<script is:inline>document.querySelector('[data-pause]')?.addEventListener('click',e=>{const paused=e.currentTarget.dataset.paused==='1';e.currentTarget.dataset.paused=paused?'0':'1';e.currentTarget.textContent=paused?'Pause Copier':'Resume Copier';});</script>
</DashboardLayout>
