---
import BaseLayout from '../../layouts/BaseLayout.astro'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Log in — Trade Avata"><section class="auth-shell"><div class="auth-card"><span class="eyebrow">Account</span><h1>Welcome back</h1><p>Sign in to continue learning, access purchases and open your Trade Avata workspaces.</p><button class="google-btn" type="button" data-google>G&nbsp;&nbsp; Continue with Google</button><div class="auth-divider">or continue with email</div><form class="form-grid" data-login><label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required></label><label class="field"><span>Password</span><input name="password" type="password" autocomplete="current-password" required></label><button class="button" type="submit">Log in</button><small data-status style="color:var(--muted)"></small></form><div class="auth-links"><a href={`${base}forgot-password/`}>Forgot password?</a><a href={`${base}register/`}>Create account →</a></div></div></section><script>
import { signInWithEmailAndPassword, GoogleAuthProvider, signInWithPopup } from 'firebase/auth'; import { auth } from '../../lib/firebase/auth.js'; import { ensureUserProfile } from '../../lib/firebase/db.js';
const status=document.querySelector('[data-status]'); const go=()=>location.href=`${document.body.dataset.baseUrl||'/'}member/`;
document.querySelector('[data-login]')?.addEventListener('submit',async e=>{e.preventDefault();if(!auth){status.textContent='Authentication will activate when Firebase environment keys are configured.';return;}const f=new FormData(e.currentTarget);status.textContent='Signing in…';try{const c=await signInWithEmailAndPassword(auth,String(f.get('email')),String(f.get('password')));await ensureUserProfile(c.user);go()}catch(err){status.textContent=err?.message||'Sign-in failed.'}});
document.querySelector('[data-google]')?.addEventListener('click',async()=>{if(!auth){status.textContent='Google sign-in will activate when Firebase is configured.';return;}status.textContent='Opening Google sign-in…';try{const c=await signInWithPopup(auth,new GoogleAuthProvider());await ensureUserProfile(c.user);go()}catch(err){status.textContent=err?.message||'Google sign-in failed.'}});
</script></BaseLayout>
