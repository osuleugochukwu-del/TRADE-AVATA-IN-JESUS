---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Log in — Trade Avata">
  <section class="auth-shell">
    <div class="auth-card">
      <span class="eyebrow">Account</span>

      <h1>Welcome back</h1>

      <p>
        Sign in to continue learning, access purchases and open your
        Trade Avata workspaces.
      </p>

      <button
        class="google-btn"
        type="button"
        data-google
      >
        G&nbsp;&nbsp; Continue with Google
      </button>

      <div class="auth-divider">
        or continue with email
      </div>

      <form
        class="form-grid"
        data-login
      >
        <label class="field">
          <span>Email</span>

          <input
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </label>

        <label class="field">
          <span>Password</span>

          <input
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
        </label>

        <button
          class="button"
          type="submit"
        >
          Log in
        </button>

        <small
          data-status
          style="color:var(--muted)"
        ></small>
      </form>

      <div class="auth-links">
        <a href={`${base}forgot-password/`}>
          Forgot password?
        </a>

        <a href={`${base}register/`}>
          Create account →
        </a>
      </div>
    </div>
  </section>

  <script>
    import {
      signInWithEmailAndPassword,
      GoogleAuthProvider,
      signInWithPopup
    } from 'firebase/auth';

    import { auth } from '../../lib/firebase/auth.js';
    import { ensureUserProfile } from '../../lib/firebase/db.js';

    const status = document.querySelector('[data-status]');
    const base = document.body.dataset.baseUrl || '/';

    function goToMember() {
      location.href = `${base}member/`;
    }

    function goToVerification() {
      location.href = `${base}verify-email/?required=1`;
    }

    document
      .querySelector('[data-login]')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!auth) {
          status.textContent =
            'Firebase Authentication is not available on this build.';
          return;
        }

        const form = new FormData(event.currentTarget);

        const email = String(form.get('email') || '').trim();
        const password = String(form.get('password') || '');

        status.textContent = 'Signing in…';

        try {
          const credential =
            await signInWithEmailAndPassword(
              auth,
              email,
              password
            );

          await credential.user.reload();

          if (!credential.user.emailVerified) {
            status.textContent =
              'Please verify your email before entering your account.';

            goToVerification();
            return;
          }

          await ensureUserProfile(credential.user);

          goToMember();

        } catch (error) {
          console.error('Login error:', error);

          if (
            error?.code === 'auth/invalid-credential' ||
            error?.code === 'auth/wrong-password' ||
            error?.code === 'auth/user-not-found'
          ) {
            status.textContent =
              'The email or password you entered is incorrect.';
          } else if (error?.code === 'auth/too-many-requests') {
            status.textContent =
              'Too many login attempts. Please wait a little while and try again.';
          } else {
            status.textContent =
              error?.message || 'Sign-in failed.';
          }
        }
      });

    document
      .querySelector('[data-google]')
      ?.addEventListener('click', async () => {
        if (!auth) {
          status.textContent =
            'Firebase Authentication is not available on this build.';
          return;
        }

        status.textContent =
          'Opening Google sign-in…';

        try {
          const credential =
            await signInWithPopup(
              auth,
              new GoogleAuthProvider()
            );

          await ensureUserProfile(credential.user);

          goToMember();

        } catch (error) {
          console.error('Google sign-in error:', error);

          status.textContent =
            error?.message || 'Google sign-in failed.';
        }
      });
  </script>
</BaseLayout>
