---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site.js';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Indicators — Trade Avata" description="Professional Trade Avata indicators for MT4, MT5, cTrader and TradingView.">
<section class="page-hero"><div class="shell"><span class="eyebrow">Indicators</span><h1 class="page-title">Professional indicators, without the clutter.</h1><p class="lead">Browse Trade Avata indicators by platform and open a dedicated product page for details, compatibility and access.</p></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">Product library</span><h2>Find the right tool for your workflow.</h2></div><div style="display:flex;gap:7px;flex-wrap:wrap" data-filters>{['All','MT4','MT5','cTrader','TradingView'].map(x=><button class="button ghost button-small" data-filter={x}>{x}</button>)}</div></div><div class="grid grid-3" data-products>{products.map(p=><a class="card card-link" href={`${base}products/${p.slug}/`} data-platforms={p.platforms.join('|')}><div style="height:150px;border-radius:10px;background:linear-gradient(135deg,#071625,#0b416f);margin-bottom:14px;position:relative;overflow:hidden"><span class="tag dark" style="position:absolute;top:10px;left:10px">{p.platforms.join(' · ')}</span><strong style="position:absolute;left:14px;bottom:14px;color:#fff;font-size:23px;line-height:1">{p.name.replace('Trade Avata ','')}</strong></div><h3>{p.name}</h3><p>{p.short}</p><div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px"><span style="font-size:11px;color:#f3a515">★★★★★ <small style="color:var(--muted)">{p.rating}</small></span><b>${p.price}</b></div></a>)}</div></div></section>
<script is:inline>const btns=[...document.querySelectorAll('[data-filter]')],cards=[...document.querySelectorAll('[data-products]>a')];btns.forEach(b=>b.addEventListener('click',()=>{btns.forEach(x=>x.classList.toggle('primary',x===b));cards.forEach(c=>c.hidden=b.dataset.filter!=='All'&&!c.dataset.platforms.split('|').includes(b.dataset.filter))}));</script>
</BaseLayout>
