---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site.js';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}))}
const {product}=Astro.props; const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${product.name} — Trade Avata`} description={product.short}>
<section class="page-hero"><div class="shell split"><div><span class="eyebrow">{product.type}</span><h1 class="page-title">{product.name}</h1><p class="lead">{product.description}</p><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px">{product.platforms.map(x=><span class="tag dark">{x}</span>)}</div><div style="display:flex;gap:10px;margin-top:22px"><a class="button" href={`${base}register/`}>Get Access — ${product.price}</a><a class="button ghost" href={`${base}contact/`}>Ask a question</a></div></div><div class="card" style="min-height:310px;background:linear-gradient(135deg,#071625,#0a416f);display:grid;place-items:center;color:#fff"><div style="text-align:center"><small style="letter-spacing:.12em;color:#85bde8">TRADE AVATA INDICATOR</small><h2 style="font-size:42px;line-height:.95;margin:12px">{product.name.replace('Trade Avata ','')}</h2><span class="tag dark">Live chart preview</span></div></div></div></section>
<section class="section"><div class="shell grid grid-3"><article class="card card-link"><span class="eyebrow">Compatibility</span><h3>Built for your platform</h3><p>{product.platforms.join(', ')} support is listed for this product. Final download access will follow the product license attached to your account.</p></article><article class="card card-link"><span class="eyebrow">What it does</span><h3>Clearer decisions</h3><p>{product.short}</p></article><article class="card card-link"><span class="eyebrow">Support</span><h3>Installation guidance</h3><p>Members receive product updates, download access and installation guidance from the member area.</p></article></div></section>
<section class="section alt"><div class="shell"><div class="section-head center"><span class="eyebrow">How it fits</span><h2>A professional tool, not a promise of profit.</h2><p>Use indicators as decision support alongside risk management, testing and your own trading process.</p></div><div class="grid grid-3"><div class="card card-link"><h3>1. Add to your chart</h3><p>Install the correct version for your supported platform.</p></div><div class="card card-link"><h3>2. Configure your view</h3><p>Adjust supported inputs and keep only the information relevant to your setup.</p></div><div class="card card-link"><h3>3. Review the evidence</h3><p>Use Analytics and Journal to understand how the tool performs inside your own process.</p></div></div></div></section>
</BaseLayout>
