---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import {courses} from '../../../data/site.js'; export function getStaticPaths(){return courses.map(course=>({params:{slug:course.slug},props:{course}}))}; const {course}=Astro.props; const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${course.title} Player — Trade Avata`}><section class="section dark" style="padding-top:22px"><div class="shell"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px"><div><span class="eyebrow">Course Player</span><h1 style="font-size:24px;margin:4px 0">{course.title}</h1></div><a class="button ghost button-small" href={`${base}courses/${course.slug}/`}>Course details</a></div><div style="display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px" class="course-player-grid"><div><div class="card" style="aspect-ratio:16/9;background:#02070d;border-color:#1e3b55;display:grid;place-items:center;color:#fff"><button class="button" data-play>▶ Play Lesson</button></div><div class="card" style="margin-top:10px;padding:18px;background:#081827;border-color:#1e3b55"><small style="color:#6db8f7">LESSON 1</small><h2 style="font-size:19px">Introduction and course workflow</h2><p style="color:#9db0c3;font-size:12px">Learn how this course is structured, what to record and how to continue from the same point later.</p><button class="button button-small" data-complete>Mark complete</button> <span data-status style="font-size:10px;color:#20c990"></span></div></div><aside class="card" style="padding:12px;background:#081827;border-color:#1e3b55"><h3>Course content</h3>{Array.from({length:course.lessons},(_,i)=><button data-lesson={i+1} style="width:100%;text-align:left;border:0;border-bottom:1px solid #18334c;background:transparent;color:#cfe0ee;padding:11px 6px;font-size:11px">{i+1}. {i===0?'Introduction and workflow':'Lesson '+(i+1)}</button>)}</aside></div></div></section><style>@media(max-width:760px){.course-player-grid{grid-template-columns:1fr!important}.course-player-grid aside{max-height:320px;overflow:auto}}</style><script is:inline>document.querySelector('[data-play]')?.addEventListener('click',e=>e.currentTarget.textContent='❚❚ Playing demo');document.querySelector('[data-complete]')?.addEventListener('click',()=>{localStorage.setItem('ta-course-progress',JSON.stringify({course:document.title,lesson:1,complete:true}));document.querySelector('[data-status]').textContent='✓ Progress saved on this device'});document.querySelectorAll('[data-lesson]').forEach(x=>x.addEventListener('click',()=>document.querySelector('[data-status]').textContent='Lesson '+x.dataset.lesson+' selected'));</script></BaseLayout>
