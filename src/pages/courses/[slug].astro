---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {courses} from '../../data/site.js'; export function getStaticPaths(){return courses.map(course=>({params:{slug:course.slug},props:{course}}))}; const {course}=Astro.props; const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${course.title} — Trade Avata`}><section class="page-hero"><div class="shell split"><div><span class="eyebrow">{course.level} course</span><h1 class="page-title">{course.title}</h1><p class="lead">{course.description}</p><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px"><span class="tag dark">{course.modules} modules</span><span class="tag dark">{course.lessons} lessons</span><span class="tag dark">{course.duration}</span></div><a class="button" style="margin-top:22px" href={`${base}courses/${course.slug}/player/`}>Start Course →</a></div><div class="card" style="min-height:300px;background:linear-gradient(135deg,#071625,#0b4b7c);display:grid;place-items:center;color:#fff"><div style="text-align:center"><small>TRADE AVATA COURSE</small><h2 style="font-size:36px;max-width:420px;line-height:1;margin:10px">{course.title}</h2><span>▶ Preview lesson</span></div></div></div></section><section class="section"><div class="shell split"><div><span class="eyebrow">Course outline</span><h2 style="font-size:34px;letter-spacing:-.04em">A clear path from foundation to review.</h2><p class="lead">Each module combines explanation, examples and a practical checkpoint so progress is easy to resume.</p></div><div class="card">{Array.from({length:course.modules},(_,i)=><div style="padding:14px 16px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between"><span><b>Module {i+1}</b><small style="display:block;color:var(--muted)">Lessons and practical review</small></span><span>→</span></div>)}</div></div></section></BaseLayout>
