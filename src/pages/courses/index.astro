---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {courses} from '../../data/site.js'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Trading Courses — Trade Avata"><section class="page-hero"><div class="shell"><span class="eyebrow">Learn</span><h1 class="page-title">Trading courses built around practical progress.</h1><p class="lead">Choose a course, see exactly what you will learn, and continue from where you left off.</p></div></section><section class="section"><div class="shell grid grid-3">{courses.map((c,i)=><article class="card"><a href={`${base}courses/${c.slug}/`} style={`display:block;height:165px;background:${i%2?'linear-gradient(135deg,#071625,#0c4f7c)':'linear-gradient(135deg,#0b1522,#31546f)'};position:relative`}><span class="tag dark" style="position:absolute;top:11px;right:11px">{c.lessons} Lessons</span><strong style="position:absolute;left:16px;bottom:16px;color:#fff;font-size:24px;max-width:80%;line-height:1">{c.title}</strong></a><div class="card-body"><span class="chip">{c.level}</span><p>{c.description}</p><div style="display:flex;gap:8px"><a class="button button-small" href={`${base}courses/${c.slug}/`}>Course details</a><a class="button ghost button-small" href={`${base}courses/${c.slug}/player/`}>Start learning</a></div></div></article>)}</div></section></BaseLayout>
