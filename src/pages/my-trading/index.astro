---
const base = import.meta.env.BASE_URL;

const cards = [
  [
    "Trading Accounts",
    "Connect an account once and let Trade Avata share it safely across your tools.",
    "#connected-accounts",
    "Manage accounts"
  ],
  [
    "Journal",
    "Use the same connected account for automatic and manual trade journaling.",
    `${base}journal/`,
    "Open journal"
  ],
  [
    "AI Analytics",
    "Analyse the same account and trade data without reconnecting elsewhere.",
    `${base}analytics/`,
    "Open analytics"
  ],
  [
    "Copy Trading",
    "Choose which connected accounts may later participate in Trade Avata Copy Trading.",
    "#connected-accounts",
    "Manage access"
  ]
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />
  <title>My Trading — Trade Avata</title>
</head>

<body data-base-url={base}>
  <main class="page">

    <header class="topbar">
      <a href={base} class="brand">
        <img
          src={`${base}brand/trade-avata-mark.png`}
          alt="Trade Avata"
        />
      </a>

      <nav>
        <a href={base}>Home</a>
        <a href={`${base}trade/`}>Trade</a>
        <a href={`${base}tools/`}>Tools</a>
        <a
          href={`${base}my-trading/`}
          aria-current="page"
        >
          My Trading
        </a>
      </nav>
    </header>

    <section class="hero">
      <div>
        <p class="eyebrow">TRADE AVATA ACCOUNT CENTER</p>

        <h1>My Trading</h1>

        <p class="lead">
          Connect a trading account once, then choose which Trade Avata tools
          may use it. Journal, Analytics, Chart and Copy Trading will all work
          from the same account identity.
        </p>
      </div>

      <button
        class="button"
        type="button"
        data-open-account-form
      >
        + Add trading account
      </button>
    </section>

    <section class="grid">
      {
        cards.map(([title, description, href, action]) => (
          <article class="card">
            <span class="dot"></span>

            <h2>{title}</h2>

            <p>{description}</p>

            <a href={href}>
              {action} →
            </a>
          </article>
        ))
      }
    </section>

    <section class="panel" id="connected-accounts">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CONNECTED ACCOUNTS</p>
          <h2>Your trading accounts</h2>
          <p class="muted">
            These account records are shared across Trade Avata.
            Broker passwords and private trading credentials are not stored here.
          </p>
        </div>

        <button
          class="secondary-button"
          type="button"
          data-open-account-form
        >
          Add account
        </button>
      </div>

      <div class="state-message" data-account-status>
        Checking your Trade Avata account…
      </div>

      <div class="accounts" data-account-list hidden></div>

      <div class="empty-state" data-empty-state hidden>
        <h3>No trading account added yet</h3>
        <p>
          Add your first MT4, MT5 or cTrader account record.
          The secure broker/VPS connection will be attached to this same account later.
        </p>

        <button
          class="button"
          type="button"
          data-open-account-form
        >
          Add first account
        </button>
      </div>
    </section>

    <section class="panel">
      <p class="eyebrow">ONE ACCOUNT · MANY TOOLS</p>

      <h2>Choose where each account can be used.</h2>

      <p>
        Every saved trading account has service switches. This keeps the whole
        Trade Avata ecosystem together without forcing you to reconnect the same
        broker account again and again.
      </p>

      <div class="service-flow">
        <span>Trading Account</span>
        <b>→</b>
        <span>Chart</span>
        <span>Journal</span>
        <span>Analytics</span>
        <span>Copy Trading</span>
      </div>
    </section>

    <section class="panel">
      <p class="eyebrow">TRADING DEVELOPMENT</p>

      <h2>Plan. Trade. Review. Improve.</h2>

      <p>
        Your connected data should help you understand what happened,
        why it happened, and what to improve next.
      </p>

      <div class="steps">
        <span>01 Plan</span>
        <span>02 Trade</span>
        <span>03 Record</span>
        <span>04 Review</span>
        <span>05 Analyse</span>
        <span>06 Improve</span>
      </div>
    </section>

  </main>

  <div
    class="modal"
    data-account-modal
    hidden
  >
    <div class="modal-backdrop" data-close-account-form></div>

    <section
      class="modal-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="account-dialog-title"
    >
      <div class="modal-head">
        <div>
          <p class="eyebrow">SHARED TRADING ACCOUNT</p>
          <h2 id="account-dialog-title">Add trading account</h2>
        </div>

        <button
          class="close-button"
          type="button"
          aria-label="Close"
          data-close-account-form
        >
          ×
        </button>
      </div>

      <p class="security-note">
        Do not enter your trading password, investor password, API secret,
        access token or any other private broker credential here.
      </p>

      <form data-account-form>
        <label>
          Account name
          <input
            name="accountLabel"
            type="text"
            maxlength="80"
            placeholder="Example: Main Trading Account"
            required
          />
        </label>

        <div class="form-grid">
          <label>
            Platform
            <select name="platform" required>
              <option value="">Choose platform</option>
              <option value="MT4">MT4</option>
              <option value="MT5">MT5</option>
              <option value="cTrader">cTrader</option>
            </select>
          </label>

          <label>
            Broker
            <input
              name="broker"
              type="text"
              maxlength="100"
              placeholder="Broker name"
              required
            />
          </label>
        </div>

        <label>
          Account reference
          <input
            name="accountReference"
            type="text"
            maxlength="100"
            placeholder="Account number or safe reference"
            required
          />
        </label>

        <fieldset>
          <legend>Use this account with</legend>

          <label class="check-row">
            <input type="checkbox" name="chart" checked />
            <span>
              <b>Chart</b>
              <small>Make this account available to Trade Avata Chart.</small>
            </span>
          </label>

          <label class="check-row">
            <input type="checkbox" name="journal" checked />
            <span>
              <b>Journal</b>
              <small>Allow trades from this account to feed the Journal later.</small>
            </span>
          </label>

          <label class="check-row">
            <input type="checkbox" name="analytics" checked />
            <span>
              <b>Analytics</b>
              <small>Allow performance data from this account to feed Analytics.</small>
            </span>
          </label>

          <label class="check-row">
            <input type="checkbox" name="copyTrading" />
            <span>
              <b>Copy Trading</b>
              <small>
                Prepare this account for Copy Trading. Live execution still requires
                the secure VPS/backend connection.
              </small>
            </span>
          </label>
        </fieldset>

        <div class="form-message" data-form-message></div>

        <div class="form-actions">
          <button
            class="secondary-button"
            type="button"
            data-close-account-form
          >
            Cancel
          </button>

          <button
            class="button"
            type="submit"
            data-save-account
          >
            Save account
          </button>
        </div>
      </form>
    </section>
  </div>
</body>
</html>

<script>
  import {
    addDoc,
    collection,
    getFirestore,
    onSnapshot,
    query,
    serverTimestamp,
    updateDoc,
    doc,
    where
  } from 'firebase/firestore';

  import {
    auth,
    onAuthStateChanged
  } from '../../lib/firebase/auth.js';

  import {
    firebaseApp
  } from '../../lib/firebase/config.js';

  const base =
    document.body?.dataset?.baseUrl || '/';

  const accountList =
    document.querySelector('[data-account-list]');

  const accountStatus =
    document.querySelector('[data-account-status]');

  const emptyState =
    document.querySelector('[data-empty-state]');

  const modal =
    document.querySelector('[data-account-modal]');

  const form =
    document.querySelector('[data-account-form]');

  const formMessage =
    document.querySelector('[data-form-message]');

  const saveButton =
    document.querySelector('[data-save-account]');

  let currentUser = null;
  let unsubscribeAccounts = null;

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function openModal() {
    if (!currentUser) {
      location.href =
        `${base}login/?redirect=my-trading`;
      return;
    }

    form?.reset();

    const chart =
      form?.querySelector('[name="chart"]');

    const journal =
      form?.querySelector('[name="journal"]');

    const analytics =
      form?.querySelector('[name="analytics"]');

    if (chart) chart.checked = true;
    if (journal) journal.checked = true;
    if (analytics) analytics.checked = true;

    if (formMessage) {
      formMessage.textContent = '';
    }

    if (modal) {
      modal.hidden = false;
    }
  }

  function closeModal() {
    if (modal) {
      modal.hidden = true;
    }
  }

  document
    .querySelectorAll('[data-open-account-form]')
    .forEach(button => {
      button.addEventListener('click', openModal);
    });

  document
    .querySelectorAll('[data-close-account-form]')
    .forEach(button => {
      button.addEventListener('click', closeModal);
    });

  function servicePill(label, enabled) {
    return `
      <span class="service-pill ${enabled ? 'on' : 'off'}">
        ${escapeHtml(label)}
        <b>${enabled ? 'ON' : 'OFF'}</b>
      </span>
    `;
  }

  function renderAccounts(snapshot) {
    if (!accountList || !emptyState || !accountStatus) {
      return;
    }

    const docs = snapshot.docs;

    accountStatus.hidden = true;

    if (!docs.length) {
      accountList.hidden = true;
      accountList.innerHTML = '';
      emptyState.hidden = false;
      return;
    }

    emptyState.hidden = true;
    accountList.hidden = false;

    accountList.innerHTML =
      docs.map(item => {
        const data = item.data();
        const services = data.services || {};
        const status = data.status || 'pending';

        return `
          <article class="account" data-account-id="${escapeHtml(item.id)}">
            <div class="account-main">
              <div class="account-title-row">
                <div>
                  <h3>${escapeHtml(data.accountLabel || 'Trading Account')}</h3>
                  <p>
                    ${escapeHtml(data.platform || 'Platform')}
                    ·
                    ${escapeHtml(data.broker || 'Broker')}
                  </p>
                </div>

                <span class="connection-status ${escapeHtml(status)}">
                  ${escapeHtml(status)}
                </span>
              </div>

              <small>
                Account reference:
                ${escapeHtml(data.accountReference || '—')}
              </small>
            </div>

            <div class="service-pills">
              ${servicePill('Chart', services.chart === true)}
              ${servicePill('Journal', services.journal === true)}
              ${servicePill('Analytics', services.analytics === true)}
              ${servicePill('Copy', services.copyTrading === true)}
            </div>

            <div class="account-actions">
              <button
                type="button"
                class="mini-button"
                data-service-toggle="chart"
                data-id="${escapeHtml(item.id)}"
                data-current="${services.chart === true}"
              >
                Chart
              </button>

              <button
                type="button"
                class="mini-button"
                data-service-toggle="journal"
                data-id="${escapeHtml(item.id)}"
                data-current="${services.journal === true}"
              >
                Journal
              </button>

              <button
                type="button"
                class="mini-button"
                data-service-toggle="analytics"
                data-id="${escapeHtml(item.id)}"
                data-current="${services.analytics === true}"
              >
                Analytics
              </button>

              <button
                type="button"
                class="mini-button"
                data-service-toggle="copyTrading"
                data-id="${escapeHtml(item.id)}"
                data-current="${services.copyTrading === true}"
              >
                Copy Trading
              </button>
            </div>
          </article>
        `;
      }).join('');
  }

  async function toggleService(button) {
    if (!currentUser || !firebaseApp) {
      return;
    }

    const id =
      button.dataset.id;

    const service =
      button.dataset.serviceToggle;

    const current =
      button.dataset.current === 'true';

    if (!id || !service) {
      return;
    }

    button.disabled = true;

    try {
      const db =
        getFirestore(firebaseApp);

      await updateDoc(
        doc(db, 'tradingAccounts', id),
        {
          [`services.${service}`]: !current,
          updatedAt: serverTimestamp()
        }
      );
    } catch (error) {
      console.error(
        'Unable to update trading account service:',
        error
      );

      alert(
        'Trade Avata could not update this account right now.'
      );
    } finally {
      button.disabled = false;
    }
  }

  accountList?.addEventListener(
    'click',
    event => {
      const button =
        event.target.closest('[data-service-toggle]');

      if (button) {
        toggleService(button);
      }
    }
  );

  form?.addEventListener(
    'submit',
    async event => {
      event.preventDefault();

      if (!currentUser || !firebaseApp) {
        location.href =
          `${base}login/?redirect=my-trading`;
        return;
      }

      const data =
        new FormData(form);

      const accountLabel =
        String(data.get('accountLabel') || '').trim();

      const platform =
        String(data.get('platform') || '').trim();

      const broker =
        String(data.get('broker') || '').trim();

      const accountReference =
        String(data.get('accountReference') || '').trim();

      if (
        !accountLabel ||
        !platform ||
        !broker ||
        !accountReference
      ) {
        if (formMessage) {
          formMessage.textContent =
            'Please complete every required field.';
        }
        return;
      }

      if (saveButton) {
        saveButton.disabled = true;
        saveButton.textContent = 'Saving…';
      }

      if (formMessage) {
        formMessage.textContent = '';
      }

      try {
        const db =
          getFirestore(firebaseApp);

        await addDoc(
          collection(db, 'tradingAccounts'),
          {
            userId: currentUser.uid,
            accountLabel,
            platform,
            broker,
            accountReference,
            status: 'pending',
            connectionType: 'backend-required',

            services: {
              chart:
                data.get('chart') === 'on',

              journal:
                data.get('journal') === 'on',

              analytics:
                data.get('analytics') === 'on',

              copyTrading:
                data.get('copyTrading') === 'on'
            },

            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp(),
            lastConnectedAt: null
          }
        );

        closeModal();

      } catch (error) {
        console.error(
          'Unable to save trading account:',
          error
        );

        if (formMessage) {
          formMessage.textContent =
            'Trade Avata could not save this account. Please try again.';
        }
      } finally {
        if (saveButton) {
          saveButton.disabled = false;
          saveButton.textContent = 'Save account';
        }
      }
    }
  );

  if (!auth || !firebaseApp) {

    if (accountStatus) {
      accountStatus.textContent =
        'Firebase is not available on this page.';
    }

  } else {

    onAuthStateChanged(
      auth,
      user => {
        currentUser = user;

        if (unsubscribeAccounts) {
          unsubscribeAccounts();
          unsubscribeAccounts = null;
        }

        if (!user) {
          if (accountStatus) {
            accountStatus.textContent =
              'Sign in to view your connected trading accounts.';
          }

          if (accountList) {
            accountList.hidden = true;
          }

          if (emptyState) {
            emptyState.hidden = true;
          }

          return;
        }

        if (accountStatus) {
          accountStatus.hidden = false;
          accountStatus.textContent =
            'Loading your trading accounts…';
        }

        const db =
          getFirestore(firebaseApp);

        const accountsQuery =
          query(
            collection(db, 'tradingAccounts'),
            where('userId', '==', user.uid)
          );

        unsubscribeAccounts =
          onSnapshot(
            accountsQuery,
            renderAccounts,
            error => {
              console.error(
                'Unable to load trading accounts:',
                error
              );

              if (accountStatus) {
                accountStatus.hidden = false;
                accountStatus.textContent =
                  'Trade Avata could not load your trading accounts.';
              }
            }
          );
      }
    );

  }
</script>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #07111f;
    color: #edf4ff;
    font: 16px system-ui, sans-serif;
  }

  button,
  input,
  select {
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 8px 0 42px;
    border-bottom: 1px solid #ffffff1a;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    width: 210px;
    height: auto;
    display: block;
  }

  nav {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }

  nav a,
  .card a,
  .section-heading a {
    color: #9dccff;
    text-decoration: none;
  }

  nav a:hover,
  .card a:hover,
  .section-heading a:hover {
    text-decoration: underline;
  }

  .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    padding: 70px 0 45px;
  }

  .eyebrow {
    color: #79b7ff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    margin: 0 0 10px;
  }

  h1 {
    font-size: clamp(42px, 7vw, 76px);
    line-height: 0.95;
    margin: 0;
  }

  h2 {
    margin: 0 0 10px;
  }

  h3 {
    margin: 0;
  }

  .lead {
    max-width: 720px;
    color: #9eacc0;
    font-size: 18px;
    line-height: 1.6;
  }

  .button,
  .secondary-button {
    padding: 13px 18px;
    border-radius: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .button {
    border: 1px solid #fff;
    background: #fff;
    color: #07111f;
  }

  .secondary-button {
    border: 1px solid #ffffff2b;
    background: #0d1b2b;
    color: #dcecff;
  }

  .button:hover,
  .secondary-button:hover {
    opacity: 0.9;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .card,
  .panel {
    border: 1px solid #ffffff1a;
    background: #ffffff09;
    border-radius: 18px;
  }

  .card {
    padding: 24px;
    min-height: 205px;
    display: flex;
    flex-direction: column;
  }

  .card p,
  .panel > p,
  .muted {
    color: #96a5ba;
    line-height: 1.55;
  }

  .card p {
    flex: 1;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #7ab8ff;
    margin-bottom: 25px;
  }

  .panel {
    margin-top: 18px;
    padding: 28px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 18px;
  }

  .section-heading .muted {
    max-width: 720px;
    margin: 6px 0 0;
  }

  .state-message,
  .empty-state {
    padding: 22px;
    border: 1px dashed #ffffff24;
    border-radius: 14px;
    color: #9eacc0;
  }

  .empty-state h3 {
    color: #edf4ff;
    margin-bottom: 8px;
  }

  .empty-state p {
    max-width: 700px;
    line-height: 1.55;
  }

  .accounts {
    display: grid;
    gap: 12px;
  }

  .account {
    padding: 18px;
    border: 1px solid #ffffff14;
    border-radius: 14px;
    background: #081624;
  }

  .account-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .account-main p {
    color: #8494a9;
    margin: 5px 0 9px;
  }

  small {
    color: #8494a9;
  }

  .connection-status {
    padding: 6px 9px;
    border-radius: 999px;
    border: 1px solid #ffffff1c;
    color: #b9c8d9;
    font-size: 11px;
    text-transform: capitalize;
  }

  .connection-status.connected {
    color: #7be4a8;
    border-color: #2b6d4a;
  }

  .connection-status.error {
    color: #ff9b9b;
    border-color: #7b3c48;
  }

  .service-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .service-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 9px;
    border-radius: 999px;
    font-size: 11px;
    border: 1px solid #ffffff1a;
  }

  .service-pill.on {
    color: #a9e8c3;
    background: #0d2a1c;
  }

  .service-pill.off {
    color: #92a0b2;
    background: #0d1620;
  }

  .account-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .mini-button {
    border: 1px solid #ffffff1a;
    background: #0c1d2e;
    color: #bcd5ee;
    padding: 8px 10px;
    border-radius: 9px;
  }

  .mini-button:hover {
    background: #112a41;
  }

  .service-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-top: 22px;
  }

  .service-flow span {
    padding: 10px 13px;
    border: 1px solid #ffffff1a;
    border-radius: 999px;
    color: #c6d2e1;
  }

  .service-flow b {
    color: #5ba9ff;
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .steps span {
    padding: 9px 12px;
    border: 1px solid #ffffff1a;
    border-radius: 999px;
    color: #c6d2e1;
    font-size: 13px;
  }

  .modal[hidden] {
    display: none !important;
  }

  .modal {
    position: fixed;
    inset: 0;
    z-index: 5000;
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: #02070dcc;
    backdrop-filter: blur(7px);
  }

