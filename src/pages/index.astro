---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, courses } from '../data/site.js';
import '../styles/homepage.css';
const base=import.meta.env.BASE_URL;
const featuredCourses=courses.slice(0,4);
const productData=products.map(p=>({...p,url:`${base}products/${p.slug}/`}));
---
<BaseLayout title="Trade Avata — Better Tools. Smarter Trading." description="AI analytics, trading journal, professional indicators and practical trading education in one platform.">
  <div class="promo-bar"><span>🎁 <b>Limited Time:</b> Get premium Trade Avata resources with your account.</span><a href={`${base}register/`}>Create account →</a></div>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="hero-copy"><span class="hero-kicker">AI POWERED. TRADER FOCUSED.</span><h1>Trading is easier<br/>when you have<br/><em>the right tool.</em></h1><p>Get AI analytics, professional indicators, step-by-step learning and practical tools — all in one place to help you trade smarter and review your process with more confidence.</p><div class="hero-actions"><a class="button" href={`${base}tools/`}>Explore Free Tools →</a><a class="button hero-secondary" href={`${base}products/`}>Browse Indicators</a></div><div class="hero-points"><span>⌁ <b>AI-Powered Analytics</b></span><span>▥ <b>Professional Indicators</b></span><span>◇ <b>Practical Education</b></span><span>◎ <b>Active Community</b></span></div></div>
      <div class="hero-device" aria-label="Trade Avata platform preview"><div class="device-top"><span>Trade Avata</span><span>EURUSD +0.82%</span></div><div class="device-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><div class="chart-path"></div><b class="buy-pin">BUY</b><b class="sell-pin">SELL</b></div><div class="device-watch"><span>EURUSD <b>+0.82%</b></span><span>XAUUSD <b>+1.14%</b></span><span>NAS100 <b>+0.47%</b></span></div></div>
    </div>
  </section>

  <section class="home-section ai-home"><div class="shell"><div class="home-head"><span>FREE AI TOOLS</span><h2>Powerful AI Tools for Every Trader</h2><p>Start using our AI-powered tools for free. Analyse performance, record decisions and build a better review process.</p></div><div class="ai-home-grid"><article class="ai-feature analytics"><div><small>◉ AI MARKET INSIGHTS</small><h3>Free AI Analytics</h3><p>Review performance, risk, drawdown and trading behaviour using evidence from your records.</p><a class="button button-small" href={`${base}analytics/`}>Try AI Analytics Free →</a></div><div class="mini-terminal"><span>Market Analysis</span><strong>EURUSD</strong><em>Confidence 78%</em><ul><li>Trend analysis</li><li>Momentum</li><li>Risk assessment</li></ul></div></article><article class="ai-feature journal"><div><small>✦ TRACK. IMPROVE. GROW.</small><h3>Free AI Journal</h3><p>Record trades, review your decisions, identify recurring strengths and understand your execution.</p><a class="button button-small" href={`${base}journal/`}>Try AI Journal Free →</a></div><div class="mini-journal"><div><span>Total Trades</span><b>124</b><em>+12.5%</em></div><div><span>Win Rate</span><b>68%</b><em>+6.2%</em></div><div class="mini-line"></div></div></article></div></div></section>

  <section class="home-section live-section"><div class="shell"><div class="home-head"><span>LIVE INDICATOR</span><h2>See Our Indicator in Action</h2><p>Watch how clean signals, structure and market context can work together in one chart.</p></div><div class="live-grid"><div class="live-chart"><div class="live-top"><b>Trade Avata Pro Indicator</b><span>EURUSD · 15m</span></div><div class="candles">{Array.from({length:46},(_,i)=><i style={`--h:${24+(i*13)%62}px;--o:${(i%2?1:-1)*(8+(i*3)%20)}px`} class={i%3===0?'red':'green'}></i>)}<span class="signal buy">BUY</span><span class="signal sell">SELL</span><span class="signal sell two">SELL</span></div></div><div class="live-benefits"><ul><li>Clear Buy & Sell Signals</li><li>Trend Direction Identification</li><li>Dynamic Support & Resistance</li><li>Works across multiple markets</li><li>Available for MT4, MT5, cTrader and TradingView</li></ul><a class="button" href={`${base}products/`}>Explore All Indicators →</a></div></div></div></section>

  <section class="home-section indicators-home"><div class="shell"><div class="home-head"><span>FEATURED INDICATORS</span><h2>Professional Indicators for Serious Traders</h2><p>Powerful, easy-to-use indicators designed to help you find better opportunities and trade with a clearer process.</p></div><div class="indicator-tabs" role="tablist"><button class="active" data-product-filter="All">All</button><button data-product-filter="MT4">MT4</button><button data-product-filter="MT5">MT5</button><button data-product-filter="cTrader">cTrader</button><button data-product-filter="TradingView">TradingView</button></div><div class="indicator-strip" data-product-grid></div></div></section>

  <section class="home-section courses-home"><div class="shell"><div class="home-head home-head-row"><div><span>LEARN TO TRADE</span><h2>Free Trading Courses</h2><p>Step-by-step courses to help you build real skills and trade with more confidence.</p></div><a class="button hero-secondary" href={`${base}courses/`}>View All Courses →</a></div><div class="course-home-grid">{featuredCourses.map((c,i)=><article class={`course-home-card course-${i+1}`}><a class="course-thumb" href={`${base}courses/${c.slug}/`}><span>{c.lessons} Lessons</span><div class="course-art"></div></a><div class="course-info"><h3>{c.title}</h3><p>{c.description}</p><a class="button button-small" href={`${base}courses/${c.slug}/player/`}>Start Learning →</a></div></article>)}</div></div></section>

  <section class="community-banner"><div class="shell community-inner"><div><span>JOIN OUR COMMUNITY</span><h2>Trade Smarter Together</h2><p>Connect with like-minded traders, share ideas, get support and grow your skills with the Trade Avata community.</p><a class="button" href={`${base}register/`}>Join Our Community →</a></div><div class="mountain-art"><i></i><i></i><i></i><b></b></div></div></section>
</BaseLayout>
<script define:vars={{productData}} is:inline>
const products=productData;const grid=document.querySelector('[data-product-grid]');const buttons=[...document.querySelectorAll('[data-product-filter]')];const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));function render(filter='All'){const list=(filter==='All'?products:products.filter(p=>p.platforms.includes(filter))).slice(0,4);grid.innerHTML=list.map(p=>`<article class="indicator-card accent-${esc(p.accent)}"><a class="indicator-art" href="${esc(p.url)}"><div class="platform-badges">${p.platforms.map(x=>`<span>${esc(x)}</span>`).join('')}</div><div class="indicator-candles"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><strong>${esc(p.name.replace('Trade Avata ',''))}</strong><b class="trade-signal">BUY</b></a><div class="indicator-copy"><h3>${esc(p.name)}</h3><p>${esc(p.short)}</p><div class="rating">★★★★★ <span>${esc(p.rating)} (${esc(p.reviews)})</span><b>$${esc(p.price)}</b></div><a class="button button-small" href="${esc(p.url)}">View Details →</a></div></article>`).join('')||'<p class="notice">No products are available in this category yet.</p>';}buttons.forEach(b=>b.addEventListener('click',()=>{buttons.forEach(x=>x.classList.toggle('active',x===b));render(b.dataset.productFilter)}));render();
</script>
