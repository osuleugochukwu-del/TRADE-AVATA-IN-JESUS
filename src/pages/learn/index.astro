---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {courses,articles} from '../../data/site.js'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Learning Hub — Trade Avata"><section class="page-hero"><div class="shell"><span class="eyebrow">Learning Hub</span><h1 class="page-title">Learn, continue and build a stronger process.</h1><p class="lead">Courses and articles are organized around practical progress instead of a crowded learning dashboard.</p><div style="display:flex;gap:9px;margin-top:20px"><a class="button" href={`${base}courses/`}>Browse Courses</a><a class="button ghost" href={`${base}articles/`}>Read Articles</a></div></div></section><section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">Featured courses</span><h2>Start with a clear path.</h2></div><a class="button ghost button-small" href={`${base}courses/`}>All courses →</a></div><div class="grid grid-3">{courses.slice(0,3).map(c=><a class="card card-link" href={`${base}courses/${c.slug}/`}><span class="chip">{c.level}</span><h3 style="margin-top:12px">{c.title}</h3><p>{c.description}</p><small>{c.lessons} lessons · {c.duration}</small></a>)}</div></div></section><section class="section alt"><div class="shell"><div class="section-head"><div><span class="eyebrow">Latest reading</span><h2>Short reads for practical review.</h2></div><a class="button ghost button-small" href={`${base}articles/`}>All articles →</a></div><div class="grid grid-3">{articles.slice(0,3).map(a=><a class="card card-link" href={`${base}articles/${a.slug}/`}><span class="chip">{a.category}</span><h3 style="margin-top:12px">{a.title}</h3><p>{a.excerpt}</p></a>)}</div></div></section></BaseLayout>
