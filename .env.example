# Public Firebase web configuration
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Optional explicit browser endpoints. If omitted, Journal can derive the default
# us-central1 Firebase Function URLs from PUBLIC_FIREBASE_PROJECT_ID.
PUBLIC_TRADE_AVATA_AI_ENDPOINT=
PUBLIC_TRADE_AVATA_EVIDENCE_PREVIEW_ENDPOINT=

# Firebase Functions / server environment only — never expose as PUBLIC_ variables.
TRADE_AVATA_AI_API_KEY=
TRADE_AVATA_AI_API_URL=https://api.openai.com/v1/chat/completions
TRADE_AVATA_AI_MODEL=gpt-4o-mini
EVIDENCE_PREVIEW_ALLOWED_HOSTS=
